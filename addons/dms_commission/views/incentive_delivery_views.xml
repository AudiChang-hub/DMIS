<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_incentive_delivery_tree" model="ir.ui.view">
    <field name="name">dms.incentive.delivery.tree</field>
    <field name="model">dms.incentive.delivery</field>
    <field name="arch" type="xml">
      <tree string="激勵核銷"
            decoration-muted="state == 'voided'"
            decoration-success="state == 'delivered'"
            decoration-warning="state == 'pending'">
        <field name="closed_month"/>
        <field name="dealer_id"/>
        <field name="sale_order_id"/>
        <field name="incentive_type_id"/>
        <field name="qty"/>
        <field name="state"/>
        <field name="delivery_method"/>
        <field name="delivered_date"/>
        <field name="delivered_by"/>
        <button name="action_mark_delivered" type="object"
                string="標記已給" icon="fa-check"
                attrs="{'invisible': [('state', '!=', 'pending')]}"
                class="btn-sm btn-success"/>
      </tree>
    </field>
  </record>

  <record id="view_incentive_delivery_form" model="ir.ui.view">
    <field name="name">dms.incentive.delivery.form</field>
    <field name="model">dms.incentive.delivery</field>
    <field name="arch" type="xml">
      <form string="激勵核銷記錄">
        <header>
          <button name="action_mark_delivered" type="object"
                  string="標記已給" class="btn-primary"
                  attrs="{'invisible': [('state', '!=', 'pending')]}"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="pending,delivered"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="sale_order_id" readonly="1"/>
              <field name="dealer_id" readonly="1"/>
              <field name="incentive_type_id" readonly="1"/>
              <field name="incentive_rule_id" readonly="1"/>
              <field name="qty" readonly="1"/>
              <field name="closed_month" readonly="1"/>
            </group>
            <group>
              <field name="delivery_method"
                     attrs="{'required': [('state', '=', 'delivered')]}"/>
              <field name="delivered_date"/>
              <field name="delivered_by"/>
            </group>
          </group>
          <group>
            <field name="remark" placeholder="輸入備註..."/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_incentive_delivery_search" model="ir.ui.view">
    <field name="name">dms.incentive.delivery.search</field>
    <field name="model">dms.incentive.delivery</field>
    <field name="arch" type="xml">
      <search string="搜尋激勵核銷">
        <field name="dealer_id"/>
        <field name="sale_order_id"/>
        <field name="incentive_type_id"/>
        <field name="closed_month"/>
        <filter name="pending" string="待給" domain="[('state','=','pending')]"/>
        <filter name="delivered" string="已給" domain="[('state','=','delivered')]"/>
        <filter name="not_voided" string="有效" domain="[('state','!=','voided')]"/>
        <group expand="0" string="群組">
          <filter name="group_dealer" string="依車行" context="{'group_by': 'dealer_id'}"/>
          <filter name="group_month" string="依月份" context="{'group_by': 'closed_month'}"/>
          <filter name="group_type" string="依品項" context="{'group_by': 'incentive_type_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_incentive_delivery" model="ir.actions.act_window">
    <field name="name">激勵核銷</field>
    <field name="res_model">dms.incentive.delivery</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state','!=','voided')]</field>
  </record>

</odoo>
