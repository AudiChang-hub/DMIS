<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ─── Search Wizard Form（圖一：搜尋入口）─── -->
  <record id="view_catalog_search_wizard_form" model="ir.ui.view">
    <field name="name">dms.part.catalog.search.wizard.form</field>
    <field name="model">dms.part.catalog.search.wizard</field>
    <field name="arch" type="xml">
      <form string="零件目錄查詢">
        <sheet>
          <group string="查詢條件">
            <group>
              <field name="engine_number" placeholder="輸入引擎號碼（如：DD278296）"/>
              <field name="template_id" placeholder="或直接選擇車型"/>
            </group>
            <group>
              <field name="section_category" widget="radio"/>
            </group>
          </group>
        </sheet>
        <footer>
          <button name="action_search" string="查詢" type="object" class="btn-primary"/>
          <button string="取消" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_catalog_search_wizard" model="ir.actions.act_window">
    <field name="name">零件查詢</field>
    <field name="res_model">dms.part.catalog.search.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

</odoo>
