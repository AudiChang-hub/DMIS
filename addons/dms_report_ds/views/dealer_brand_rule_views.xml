<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dealer_brand_rule_tree" model="ir.ui.view">
        <field name="name">dms.dealer.brand.rule.tree</field>
        <field name="model">dms.dealer.brand.rule</field>
        <field name="arch" type="xml">
            <tree string="車行品牌規則" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="pattern"/>
                <field name="result"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="note" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_dealer_brand_rule_form" model="ir.ui.view">
        <field name="name">dms.dealer.brand.rule.form</field>
        <field name="model">dms.dealer.brand.rule</field>
        <field name="arch" type="xml">
            <form string="車行品牌規則">
                <header>
                    <button name="action_rebuild_view" type="object"
                            string="重新套用規則" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="已停用"
                            bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="pattern"/>
                            <field name="result"/>
                        </group>
                    </group>
                    <group string="備註">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dealer_brand_rule" model="ir.actions.act_window">
        <field name="name">車行品牌規則</field>
        <field name="res_model">dms.dealer.brand.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="menu_dealer_brand_rule"
              name="車行品牌規則"
              parent="dms_report.menu_dms_report_root"
              action="action_dealer_brand_rule"
              sequence="61"/>

</odoo>
