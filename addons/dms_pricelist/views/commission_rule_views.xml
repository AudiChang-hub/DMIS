<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_commission_rule_tree" model="ir.ui.view">
    <field name="name">dms.commission.rule.tree</field>
    <field name="model">dms.commission.rule</field>
    <field name="arch" type="xml">
      <tree string="傭金規則">
        <field name="dealer_id"           optional="show"/>
        <field name="product_id"          optional="show"/>
        <field name="installment_periods" optional="show"/>
        <field name="commission_amount"   optional="show"/>
        <field name="commission_rate"     optional="hide"/>
        <field name="valid_from"          optional="show"/>
        <field name="valid_to"            optional="hide"/>
        <field name="active"              optional="show"/>
        <field name="note"                optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_commission_rule_form" model="ir.ui.view">
    <field name="name">dms.commission.rule.form</field>
    <field name="model">dms.commission.rule</field>
    <field name="arch" type="xml">
      <form string="傭金規則">
        <sheet>
          <group>
            <group>
              <field name="dealer_id"/>
              <field name="product_id"/>
              <field name="installment_periods"/>
              <field name="active"/>
            </group>
            <group>
              <field name="commission_amount"/>
              <field name="commission_rate"/>
            </group>
          </group>
          <group string="有效期間">
            <field name="valid_from"/>
            <field name="valid_to"/>
          </group>
          <group>
            <field name="note" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_commission_rule_search" model="ir.ui.view">
    <field name="name">dms.commission.rule.search</field>
    <field name="model">dms.commission.rule</field>
    <field name="arch" type="xml">
      <search string="搜尋傭金規則">
        <field name="dealer_id" string="車行"/>
        <field name="product_id" string="車款"/>
        <separator/>
        <filter name="filter_cash" string="現金" domain="[('installment_periods','=',0)]"/>
        <filter name="filter_installment" string="分期" domain="[('installment_periods','>',0)]"/>
        <separator/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_dealer" string="車行" context="{'group_by': 'dealer_id'}"/>
          <filter name="groupby_product" string="車款" context="{'group_by': 'product_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_commission_rule" model="ir.actions.act_window">
    <field name="name">傭金規則</field>
    <field name="res_model">dms.commission.rule</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_commission_rule" name="傭金規則" parent="menu_dms_pricelist_root"
            action="action_commission_rule" sequence="40"/>

</odoo>
