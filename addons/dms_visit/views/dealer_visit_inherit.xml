<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- 在車行表單視圖加入「拜訪紀錄」Smart Button -->
  <record id="view_dealer_form_visit_inherit" model="ir.ui.view">
    <field name="name">dms.dealer.form.visit.button</field>
    <field name="model">dms.dealer</field>
    <field name="inherit_id" ref="dms_core.view_dealer_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form/sheet/div[hasclass('oe_title')]" position="before">
        <div class="oe_button_box" name="button_box">
          <button class="oe_stat_button"
                  type="object"
                  name="action_open_visits"
                  icon="fa-calendar"
                  groups="dms_visit.group_dms_visit_user,dms_visit.group_dms_visit_admin">
            <field name="visit_count" widget="statinfo" string="拜訪紀錄"/>
          </button>
        </div>
      </xpath>
      <!-- 在備註頁籤後新增「自動拜訪」設定頁籤 -->
      <xpath expr="//notebook" position="inside">
        <page string="自動拜訪設定" groups="dms_visit.group_dms_visit_admin">
          <group>
            <field name="auto_price_list_visit"/>
            <field name="price_list_visitor_id"
                   attrs="{'invisible': [('auto_price_list_visit', '=', False)]}"/>
          </group>
          <!-- 週期設定區塊 -->
          <group string="週期設定"
                 attrs="{'invisible': [('auto_price_list_visit', '=', False)]}">
            <field name="auto_visit_schedule_type"/>
            <!-- fixed_day -->
            <field name="auto_visit_day_of_month"
                   attrs="{'invisible': [('auto_visit_schedule_type', '!=', 'fixed_day')],
                            'required': [('auto_visit_schedule_type', '=', 'fixed_day'),
                                         ('auto_price_list_visit', '=', True)]}"/>
            <!-- weekday_of_month -->
            <field name="auto_visit_week_number"
                   attrs="{'invisible': [('auto_visit_schedule_type', '!=', 'weekday_of_month')],
                            'required': [('auto_visit_schedule_type', '=', 'weekday_of_month'),
                                         ('auto_price_list_visit', '=', True)]}"/>
            <field name="auto_visit_weekday"
                   attrs="{'invisible': [('auto_visit_schedule_type', '!=', 'weekday_of_month')],
                            'required': [('auto_visit_schedule_type', '=', 'weekday_of_month'),
                                         ('auto_price_list_visit', '=', True)]}"/>
            <field name="auto_visit_next_date" readonly="1"/>
          </group>
          <!-- 操作 -->
          <div attrs="{'invisible': [('auto_price_list_visit', '=', False)]}">
            <button name="action_regenerate_visits"
                    string="重新產生未來排程"
                    type="object"
                    class="btn-secondary"
                    confirm="將刪除未來所有排程草稿並依目前設定重新產生，確定嗎？"/>
            <span class="text-muted ml8" style="font-size:12px;">
              儲存設定時會自動重新產生；此按鈕可手動強制重建。
            </span>
          </div>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
