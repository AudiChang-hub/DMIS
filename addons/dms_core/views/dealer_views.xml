<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_dealer_tree" model="ir.ui.view">
    <field name="name">dms.dealer.tree</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <tree string="車行">
        <field name="code"/>
        <field name="name"/>
        <field name="short_name"/>
        <field name="level"/>
        <field name="store_type"/>
        <field name="phone"/>
        <field name="city"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="view_dealer_form" model="ir.ui.view">
    <field name="name">dms.dealer.form</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <form string="車行">
        <sheet>
          <notebook>
            <page string="基本資料">
              <group>
                <field name="code"/>
                <field name="name"/>
                <field name="short_name"/>
                <field name="level"/>
                <field name="store_type"/>
                <field name="active"/>
              </group>
            </page>
            <page string="聯絡資訊">
              <group>
                <field name="contact_name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="address"/>
                <field name="city"/>
                <field name="district"/>
              </group>
            </page>
            <page string="組織與標籤">
              <group>
                <field name="parent_id"/>
                <field name="tags" widget="many2many_tags"/>
                <field name="partner_id"/>
              </group>
            </page>
            <page string="備註">
              <group>
                <field name="note"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_dealer_search" model="ir.ui.view">
    <field name="name">dms.dealer.search</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <search>
        <field name="code"/>
        <field name="name"/>
        <field name="phone"/>
        <field name="short_name"/>
        <filter name="active" string="啟用" domain="[(\'active\',\'=\',True)]"/>
        <filter name="level" string="層級" domain="[]"/>
        <filter name="store_type" string="類型" domain="[]"/>
        <group expand="0" string="群組">
          <groupby name="level"/>
          <groupby name="store_type"/>
          <groupby name="city"/>
        </group>
      </search>
    </field>
  </record>

  <menuitem id="menu_dms_root" name="DMS"/>
  <menuitem id="menu_dealer" name="車行" parent="menu_dms_root"/>

  <act_window id="action_dealer" name="車行" res_model="dms.dealer" view_mode="tree,form"/>
  <menuitem id="menu_dealer_action" name="列表" parent="menu_dealer" action="action_dealer"/>
</odoo>
