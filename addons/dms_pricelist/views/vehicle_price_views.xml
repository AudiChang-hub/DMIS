<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_vehicle_price_tree" model="ir.ui.view">
    <field name="name">dms.vehicle.price.tree</field>
    <field name="model">dms.vehicle.price</field>
    <field name="arch" type="xml">
      <tree string="車款售價">
        <field name="product_id"       optional="show"/>
        <field name="cash_price"        optional="show"/>
        <field name="valid_year_month" optional="show"/>
        <field name="is_promotion"     optional="hide"/>
        <field name="active"           optional="show"/>
        <field name="note"             optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_vehicle_price_form" model="ir.ui.view">
    <field name="name">dms.vehicle.price.form</field>
    <field name="model">dms.vehicle.price</field>
    <field name="arch" type="xml">
      <form string="車款售價">
        <sheet>
          <group>
            <group>
              <field name="product_id"/>
              <field name="valid_year_month"/>
              <field name="is_promotion"/>
              <field name="active"/>
            </group>
            <group>
              <field name="cash_price"/>
            </group>
          </group>
          <notebook>
            <page string="分期方案">
              <field name="installment_ids">
                <tree editable="bottom">
                  <field name="installment_periods"/>
                  <field name="installment_monthly"/>
                  <field name="finance_company"/>
                  <field name="active"/>
                </tree>
              </field>
            </page>
            <page string="備註">
              <field name="note" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_vehicle_price_search" model="ir.ui.view">
    <field name="name">dms.vehicle.price.search</field>
    <field name="model">dms.vehicle.price</field>
    <field name="arch" type="xml">
      <search string="搜尋車款售價">
        <field name="product_id" string="車款"/>
        <field name="valid_year_month" string="有效月份"/>
        <separator/>
        <filter name="filter_promotion" string="當月活動" domain="[('is_promotion','=',True)]"/>
        <separator/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_product" string="車款" context="{'group_by': 'product_id'}"/>
          <filter name="groupby_month" string="月份" context="{'group_by': 'valid_year_month'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_vehicle_price" model="ir.actions.act_window">
    <field name="name">車款售價</field>
    <field name="res_model">dms.vehicle.price</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_dms_pricelist_root" name="DMS 價目管理"/>
  <menuitem id="menu_vehicle_price" name="車款售價" parent="menu_dms_pricelist_root"
            action="action_vehicle_price" sequence="10"/>

</odoo>
