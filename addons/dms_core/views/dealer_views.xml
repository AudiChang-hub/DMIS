<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 使用 Odoo 內建欄位選擇，已移除自建 Wizard -->

  <record id="view_dealer_tree" model="ir.ui.view">
    <field name="name">dms.dealer.tree</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <tree string="車行">
        <field name="code" optional="show"/>
        <field name="name" optional="show"/>
        <field name="short_name" optional="hide"/>
        <field name="owner_name" optional="show"/>
        <field name="store_manager" optional="show"/>
        <field name="phone_1" optional="show"/>
        <field name="phone_2" optional="hide"/>
        <field name="mobile" optional="show"/>
        <field name="mobile_fax" optional="hide"/>
        <field name="city" optional="hide"/>
        <field name="sym_price_list" optional="hide"/>
        <field name="suzuki_price_list" optional="hide"/>
        <field name="store_type_id" optional="hide"/>
        <field name="brand_ids" optional="hide"/>
        <field name="holiday_gift" optional="hide"/>
        <field name="active" optional="hide"/>
      </tree>
    </field>
  </record>

  <record id="view_dealer_form" model="ir.ui.view">
    <field name="name">dms.dealer.form</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <form string="車行">
        <sheet>
          <notebook>
            <page string="基本資料">
              <group>
                <field name="name" string="車行名稱"/>
                <field name="owner_name" string="負責人"/>
                <field name="store_manager" string="店長"/>
                <field name="store_type_id"/>
                <field name="brand_ids" widget="many2many_tags"/>
                <field name="address"/>
                <field name="note"/>
              </group>
            </page>
            <page string="聯絡資訊">
              <group>
                <field name="phone_1"/>
                <field name="phone_2"/>
                <field name="mobile"/>
                <field name="mobile_fax"/>
                <field name="email"/>
              </group>
            </page>
            <page string="價格表 / 群組">
              <group>
                <field name="sym_price_list"/>
                <field name="suzuki_price_list"/>
              </group>
              <group>
                <field name="sym_dispatch_capacity"/>
                <field name="suzuki_dispatch_capacity"/>
              </group>
              <group>
                <field name="line_group"/>
                <field name="holiday_gift"/>
              </group>
            </page>
            <page string="進階">
              <group>
                <field name="tags" widget="many2many_tags"/>
                <field name="active"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_dealer_search" model="ir.ui.view">
    <field name="name">dms.dealer.search</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <search>
        <field name="code"/>
        <field name="phone_1"/>
        <field name="mobile"/>
        <field name="phone_2"/>
        <field name="short_name"/>
        <filter name="active" string="啟用" domain="[('active','=',True)]"/>
        <filter name="holiday_gift" string="年節送禮" domain="[('holiday_gift','=',True)]"/>
        <filter name="sym_price_gas" string="三陽-油車" domain="[('sym_price_list','=','gas')]"/>
        <filter name="sym_price_ev" string="三陽-電車" domain="[('sym_price_list','=','ev')]"/>
        <filter name="suzuki_price_gas" string="台鈴-油車" domain="[('suzuki_price_list','=','gas')]"/>
        <filter name="suzuki_price_ev" string="台鈴-電車" domain="[('suzuki_price_list','=','ev')]"/>
        <group expand="0" string="分組">
          <filter name="groupby_store_type" string="車行類型" context="{'group_by': 'store_type_id'}"/>
          <filter name="groupby_city" string="縣市" context="{'group_by': 'city'}"/>
        </group>
        </search>
    </field>
  </record>

  <menuitem id="menu_dms_root" name="DMS"/>
  <menuitem id="menu_dealer" name="車行" parent="menu_dms_root"/>

  <act_window id="action_dealer" name="車行" res_model="dms.dealer" view_mode="tree,form"/>
  <menuitem id="menu_dealer_action" name="列表" parent="menu_dealer" action="action_dealer"/>
  <act_window id="action_dealer_create" name="新增車行" res_model="dms.dealer" view_mode="form" target="current" context="{'form_view_initial_mode':'edit'}"/>
  <menuitem id="menu_dealer_create" name="新增" parent="menu_dealer" action="action_dealer_create"/>
  <!-- Tag 管理介面 -->
  <record id="view_dealer_tag_tree" model="ir.ui.view">
    <field name="name">dms.dealer.tag.tree</field>
    <field name="model">dms.dealer.tag</field>
    <field name="arch" type="xml">
      <tree string="車行標籤">
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_dealer_tag_form" model="ir.ui.view">
    <field name="name">dms.dealer.tag.form</field>
    <field name="model">dms.dealer.tag</field>
    <field name="arch" type="xml">
      <form string="車行標籤">
        <sheet>
          <group>
            <field name="name"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_dealer_tag" model="ir.actions.act_window">
    <field name="name">車行標籤</field>
    <field name="res_model">dms.dealer.tag</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_dealer_tag_tree"/>
  </record>
  <menuitem id="menu_dealer_tags" name="標籤管理" parent="menu_dms_root" action="action_dealer_tag"/>
  <!-- 已移除自建欄位選擇選單，改用 Odoo 內建欄位選擇 -->
</odoo>
