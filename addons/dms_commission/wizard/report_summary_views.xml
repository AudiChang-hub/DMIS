<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- 總報表 Wizard -->
  <record id="view_report_summary_form" model="ir.ui.view">
    <field name="name">dms.commission.summary.report.form</field>
    <field name="model">dms.commission.summary.report</field>
    <field name="arch" type="xml">
      <form string="傭金總報表">
        <group>
          <group>
            <field name="date_from"/>
            <field name="date_to"/>
            <field name="dealer_ids" widget="many2many_tags"/>
          </group>
        </group>
        <group attrs="{'invisible': [('excel_file', '=', False)]}">
          <field name="excel_file" filename="excel_filename" widget="binary"/>
          <field name="excel_filename" invisible="1"/>
        </group>
        <footer>
          <button name="action_preview" type="object"
                  string="在畫面查看" class="btn-secondary"/>
          <button name="action_export_excel" type="object"
                  string="匯出 Excel" class="btn-primary"/>
          <button string="關閉" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_report_summary" model="ir.actions.act_window">
    <field name="name">傭金總報表</field>
    <field name="res_model">dms.commission.summary.report</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

</odoo>
