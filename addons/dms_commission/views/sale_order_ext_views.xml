<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- 繼承 dms.sale.order form，加入結案按鈕與傭金資訊 -->
  <record id="view_sale_order_commission_ext" model="ir.ui.view">
    <field name="name">dms.sale.order.commission.ext</field>
    <field name="model">dms.sale.order</field>
    <field name="inherit_id" ref="dms_sale.view_sale_order_form"/>
    <field name="arch" type="xml">
      <!-- 在 header 加入結案/撤銷按鈕 -->
      <xpath expr="//header" position="inside">
        <button name="action_close_order" type="object"
                string="結案" class="btn-primary"
                attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
        <button name="action_reopen_order" type="object"
                string="撤銷結案" class="btn-warning"
                confirm="確定要撤銷結案？此操作將作廢傭金記錄並重算台數獎金。"
                attrs="{'invisible': [('state', '!=', 'closed')]}"/>
      </xpath>
      <!-- 在 sheet 最後加入傭金資訊區塊 -->
      <xpath expr="//sheet" position="inside">
        <group string="傭金資訊"
               attrs="{'invisible': [('is_closed', '=', False)]}">
          <group>
            <field name="is_closed" readonly="1"/>
            <field name="closed_date" readonly="1"/>
          </group>
          <group>
            <field name="commission_record_id" readonly="1"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>

</odoo>
