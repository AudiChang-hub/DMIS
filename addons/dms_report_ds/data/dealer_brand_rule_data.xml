<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="brand_kymco" model="dms.dealer.brand.rule">
            <field name="name">光陽車行</field>
            <field name="sequence">10</field>
            <field name="pattern">〔車行〕|〔車行〕|〔車行〕|〔車行〕|〔車行〕|〔車行〕|〔車行〕|〔車行〕</field>
            <field name="result">光陽</field>
        </record>

        <record id="brand_sym" model="dms.dealer.brand.rule">
            <field name="name">三陽車行</field>
            <field name="sequence">20</field>
            <field name="pattern">永湛|〔車行〕|〔車行〕|〔車行〕|百福|〔車行〕|〔車行〕|〔車行〕|〔車行〕|〔車行〕|〔車行〕|東永|〔車行〕</field>
            <field name="result">三陽</field>
        </record>

        <record id="brand_yamaha" model="dms.dealer.brand.rule">
            <field name="name">山葉車行</field>
            <field name="sequence">30</field>
            <field name="pattern">馳機|天佑|旭昇|宏偉|尚勁|〔車行〕|凱弘|〔車行〕|〔車行〕|〔車行〕|〔車行〕|〔車行〕|極昇|奕鈞|〔車行〕|岩谷|昌勝|〔車行〕|金利富|泳辰|源泰|〔車行〕|嘉仁|金泰發|日信|〔車行〕|〔車行〕</field>
            <field name="result">山葉</field>
        </record>

        <record id="brand_general_a" model="dms.dealer.brand.rule">
            <field name="name">一般車行 A</field>
            <field name="sequence">40</field>
            <field name="pattern">〔車行〕|〔車行〕|〔車行〕|〔車行〕|〔車行〕|〔車行〕|上慶|〔車行〕|〔車行〕|湖州|〔車行〕</field>
            <field name="result">一般車行</field>
        </record>

        <record id="brand_general_b" model="dms.dealer.brand.rule">
            <field name="name">一般車行 B</field>
            <field name="sequence">41</field>
            <field name="pattern">〔車行〕</field>
            <field name="result">一般車行</field>
        </record>

        <record id="brand_suzuki" model="dms.dealer.brand.rule">
            <field name="name">台鈴車行</field>
            <field name="sequence">50</field>
            <field name="pattern">明輝|〔車行〕|旭昶|〔車行〕|〔車行〕|〔車行〕</field>
            <field name="result">台鈴</field>
        </record>

        <record id="brand_gogoro" model="dms.dealer.brand.rule">
            <field name="name">睿能車行</field>
            <field name="sequence">60</field>
            <field name="pattern">〔車行〕|北野電能|北野</field>
            <field name="result">睿能</field>
        </record>

        <record id="brand_ecommerce" model="dms.dealer.brand.rule">
            <field name="name">網路平台-關鍵字</field>
            <field name="sequence">70</field>
            <field name="pattern">pc|momo|yahoo|燦坤|小樹購|百利市|friday|蝦皮</field>
            <field name="result">網路平台</field>
            <field name="note">備援判斷：實際應由 dealer.store_type 為「網路平台」直接識別。</field>
        </record>

        <record id="brand_general_c_huzhou" model="dms.dealer.brand.rule">
            <field name="name">一般車行 C</field>
            <field name="sequence">42</field>
            <field name="pattern">湖洲</field>
            <field name="result">一般車行</field>
            <field name="note">補規則：與 brand_general_a 中的「湖州」並列（資料中兩種寫法皆有）。</field>
        </record>

        <record id="brand_internal_staff" model="dms.dealer.brand.rule">
            <field name="name">店內員工-文傑</field>
            <field name="sequence">80</field>
            <field name="pattern">文傑</field>
            <field name="result">馭盛</field>
            <field name="note">員工兼營訂單，brand_type 歸為馭盛；sales_source 仍維持「店內員工」。</field>
        </record>

        <record id="brand_subsidy" model="dms.dealer.brand.rule">
            <field name="name">補助申請</field>
            <field name="sequence">90</field>
            <field name="pattern">代申請補助</field>
            <field name="result">補助</field>
            <field name="note">非車行銷售，僅為補助方案申請紀錄。</field>
        </record>
    </data>
</odoo>
