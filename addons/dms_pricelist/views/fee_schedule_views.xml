<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_fee_schedule_tree" model="ir.ui.view">
    <field name="name">dms.fee.schedule.tree</field>
    <field name="model">dms.fee.schedule</field>
    <field name="arch" type="xml">
      <tree string="牌險費率">
        <field name="product_id"                optional="show"/>
        <field name="fee_registration"           optional="show"/>
        <field name="fee_compulsory_insurance"   optional="show"/>
        <field name="fee_agency"                 optional="show"/>
        <field name="valid_from"                 optional="show"/>
        <field name="valid_to"                   optional="hide"/>
        <field name="active"                     optional="show"/>
        <field name="note"                       optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_fee_schedule_form" model="ir.ui.view">
    <field name="name">dms.fee.schedule.form</field>
    <field name="model">dms.fee.schedule</field>
    <field name="arch" type="xml">
      <form string="牌險費率">
        <sheet>
          <group>
            <group>
              <field name="product_id"/>
              <field name="active"/>
            </group>
            <group>
              <field name="fee_registration"/>
              <field name="fee_compulsory_insurance"/>
              <field name="fee_agency"/>
            </group>
          </group>
          <group string="有效期間">
            <field name="valid_from"/>
            <field name="valid_to"/>
          </group>
          <group>
            <field name="note" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_fee_schedule_search" model="ir.ui.view">
    <field name="name">dms.fee.schedule.search</field>
    <field name="model">dms.fee.schedule</field>
    <field name="arch" type="xml">
      <search string="搜尋牌險費率">
        <field name="product_id" string="車款"/>
        <separator/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_product" string="車款" context="{'group_by': 'product_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_fee_schedule" model="ir.actions.act_window">
    <field name="name">牌險費率</field>
    <field name="res_model">dms.fee.schedule</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_fee_schedule" name="牌險費率" parent="menu_dms_pricelist_root"
            action="action_fee_schedule" sequence="40"/>

</odoo>
