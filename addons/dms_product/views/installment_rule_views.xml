<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_installment_rule_tree" model="ir.ui.view">
    <field name="name">dms.installment.rule.tree</field>
    <field name="model">dms.installment.rule</field>
    <field name="arch" type="xml">
      <tree string="分期規則模板">
        <field name="name" optional="show"/>
        <field name="active" optional="show"/>
        <field name="note" optional="hide"/>
      </tree>
    </field>
  </record>

  <record id="view_installment_rule_form" model="ir.ui.view">
    <field name="name">dms.installment.rule.form</field>
    <field name="model">dms.installment.rule</field>
    <field name="arch" type="xml">
      <form string="分期規則模板">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="interest_rate" string="年利率（如 0.05 = 5%）"/>
              <field name="active"/>
            </group>
            <group>
              <field name="note"/>
            </group>
          </group>
          <notebook>
            <page string="規則明細">
              <field name="line_ids" context="{'default_rule_id': active_id}">
                <tree>
                  <field name="period_from"/>
                  <field name="period_to"/>
                  <field name="price_basis"/>
                  <field name="note"/>
                </tree>
                <form string="分期規則明細">
                  <group>
                    <group>
                      <field name="period_from"/>
                      <field name="period_to"/>
                      <field name="price_basis"/>
                    </group>
                    <group>
                      <field name="note"/>
                    </group>
                  </group>
                  <group string="費用明細">
                    <field name="fee_ids">
                      <tree editable="bottom">
                        <field name="fee_type_id"/>
                        <field name="amount"/>
                        <field name="charge_mode"/>
                        <field name="note"/>
                      </tree>
                    </field>
                  </group>
                </form>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_installment_rule_search" model="ir.ui.view">
    <field name="name">dms.installment.rule.search</field>
    <field name="model">dms.installment.rule</field>
    <field name="arch" type="xml">
      <search string="搜尋分期規則模板">
        <field name="name"/>
        <filter name="filter_active" string="啟用中" domain="[('active', '=', True)]"/>
        <filter name="filter_archived" string="已停用" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="action_installment_rule" model="ir.actions.act_window">
    <field name="name">分期規則模板</field>
    <field name="res_model">dms.installment.rule</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

</odoo>
