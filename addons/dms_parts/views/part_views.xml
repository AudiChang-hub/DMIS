<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_part_tree" model="ir.ui.view">
    <field name="name">dms.part.tree</field>
    <field name="model">dms.part</field>
    <field name="arch" type="xml">
      <tree string="零件">
        <field name="name" optional="show"/>
        <field name="part_number" optional="show"/>
        <field name="category_id" optional="show"/>
        <field name="uom" optional="show"/>
        <field name="cost_price" optional="show"/>
        <field name="active" optional="show"/>
        <field name="note" optional="hide"/>
      </tree>
    </field>
  </record>

  <record id="view_part_form" model="ir.ui.view">
    <field name="name">dms.part.form</field>
    <field name="model">dms.part</field>
    <field name="arch" type="xml">
      <form string="零件">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="part_number" placeholder="原廠料號（選填）"/>
              <field name="category_id"/>
            </group>
            <group>
              <field name="uom"/>
              <field name="cost_price"/>
              <field name="active"/>
            </group>
          </group>
          <separator string="備註"/>
          <field name="note" nolabel="1" placeholder="請輸入備註內容..."/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_part" model="ir.actions.act_window">
    <field name="name">零件</field>
    <field name="res_model">dms.part</field>
    <field name="view_mode">tree,form</field>
  </record>

  <record id="view_part_search" model="ir.ui.view">
    <field name="name">dms.part.search</field>
    <field name="model">dms.part</field>
    <field name="arch" type="xml">
      <search string="零件搜尋">
        <field name="name" string="名稱"/>
        <field name="part_number" string="料號"/>
        <field name="category_id" string="分類"/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <separator/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
        <group expand="0" string="分組依據">
          <filter name="group_category" string="分類" context="{'group_by': 'category_id'}"/>
        </group>
      </search>
    </field>
  </record>

</odoo>
