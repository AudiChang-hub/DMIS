<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <data noupdate="1">

    <!-- ╔══════════════════════════════════════════════════════════╗ -->
    <!-- ║  Record Rules — dms.report.virtual.field               ║ -->
    <!-- ╚══════════════════════════════════════════════════════════╝ -->

    <!-- 使用者讀取：自己建立的 OR 公開 -->
    <record id="rule_vf_user_read" model="ir.rule">
      <field name="name">虛擬欄位：使用者可讀取（自己 + 公開）</field>
      <field name="model_id" ref="model_dms_report_virtual_field"/>
      <field name="domain_force">
        ['|', ('owner_id', '=', user.id), ('public', '=', True)]
      </field>
      <field name="groups" eval="[(4, ref('group_dms_report_virtual_user'))]"/>
      <field name="perm_read"   eval="True"/>
      <field name="perm_write"  eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 使用者寫入/刪除：僅限自己建立的 -->
    <record id="rule_vf_user_write" model="ir.rule">
      <field name="name">虛擬欄位：使用者只能修改/刪除自己的定義</field>
      <field name="model_id" ref="model_dms_report_virtual_field"/>
      <field name="domain_force">
        [('owner_id', '=', user.id)]
      </field>
      <field name="groups" eval="[(4, ref('group_dms_report_virtual_user'))]"/>
      <field name="perm_read"   eval="False"/>
      <field name="perm_write"  eval="True"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <!-- 管理員：無限制讀取所有虛擬欄位 -->
    <record id="rule_vf_admin_read" model="ir.rule">
      <field name="name">虛擬欄位：管理員全覽</field>
      <field name="model_id" ref="model_dms_report_virtual_field"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_dms_report_virtual_admin'))]"/>
      <field name="perm_read"   eval="True"/>
      <field name="perm_write"  eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!-- 管理員：無限制寫入/刪除所有虛擬欄位 -->
    <record id="rule_vf_admin_write" model="ir.rule">
      <field name="name">虛擬欄位：管理員全寫</field>
      <field name="model_id" ref="model_dms_report_virtual_field"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_dms_report_virtual_admin'))]"/>
      <field name="perm_read"   eval="False"/>
      <field name="perm_write"  eval="True"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ╔══════════════════════════════════════════════════════════╗ -->
    <!-- ║  Record Rules — dms.report.virtual.field.rule          ║ -->
    <!-- ╚══════════════════════════════════════════════════════════╝ -->

    <record id="rule_vf_rule_user_read" model="ir.rule">
      <field name="name">虛擬欄位規則行：使用者可讀取（父欄位自己 + 公開）</field>
      <field name="model_id" ref="model_dms_report_virtual_field_rule"/>
      <field name="domain_force">
        ['|', ('virtual_field_id.owner_id', '=', user.id),
              ('virtual_field_id.public', '=', True)]
      </field>
      <field name="groups" eval="[(4, ref('group_dms_report_virtual_user'))]"/>
      <field name="perm_read"   eval="True"/>
      <field name="perm_write"  eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_vf_rule_user_write" model="ir.rule">
      <field name="name">虛擬欄位規則行：使用者只能修改自己的規則行</field>
      <field name="model_id" ref="model_dms_report_virtual_field_rule"/>
      <field name="domain_force">[('virtual_field_id.owner_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_dms_report_virtual_user'))]"/>
      <field name="perm_read"   eval="False"/>
      <field name="perm_write"  eval="True"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_vf_rule_admin_read" model="ir.rule">
      <field name="name">虛擬欄位規則行：管理員全覽</field>
      <field name="model_id" ref="model_dms_report_virtual_field_rule"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_dms_report_virtual_admin'))]"/>
      <field name="perm_read"   eval="True"/>
      <field name="perm_write"  eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_vf_rule_admin_write" model="ir.rule">
      <field name="name">虛擬欄位規則行：管理員全寫</field>
      <field name="model_id" ref="model_dms_report_virtual_field_rule"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_dms_report_virtual_admin'))]"/>
      <field name="perm_read"   eval="False"/>
      <field name="perm_write"  eval="True"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="True"/>
    </record>

  </data>

</odoo>
