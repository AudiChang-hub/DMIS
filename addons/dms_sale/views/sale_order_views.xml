<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_sale_order_tree" model="ir.ui.view">
    <field name="name">dms.sale.order.tree</field>
    <field name="model">dms.sale.order</field>
    <field name="arch" type="xml">
      <tree string="銷售訂單">
        <field name="name"              optional="show"/>
        <field name="order_date"        optional="show"/>
        <field name="sale_type"         optional="show"/>
        <field name="customer_name"     optional="show"/>
        <field name="customer_phone"    optional="hide"/>
        <field name="product_id"        optional="show"/>
        <field name="amount_total"      optional="show"/>
        <field name="deposit_amount"    optional="hide"/>
        <field name="balance_amount"    optional="hide"/>
        <field name="is_settled"        optional="show"/>
        <field name="plate_number"      optional="hide"/>
        <field name="registration_date" optional="hide"/>
        <field name="dealer_id"         optional="hide"/>
        <field name="state"             optional="show"/>
        <field name="active"            optional="show"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_sale_order_form" model="ir.ui.view">
    <field name="name">dms.sale.order.form</field>
    <field name="model">dms.sale.order</field>
    <field name="arch" type="xml">
      <form string="銷售訂單">
        <header>
          <button string="確認訂單" name="button_confirm" type="object"
                  class="oe_highlight"
                  attrs="{'invisible': [('state', '!=', 'draft')]}"/>
          <button string="重回草稿" name="button_reset" type="object"
                  attrs="{'invisible': [('state', 'not in', ['confirmed', 'cancel'])]}"/>
          <button string="取消訂單" name="button_cancel" type="object"
                  attrs="{'invisible': [('state', 'not in', ['draft', 'confirmed'])]}"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,confirmed,cancel"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <!-- 供 attrs 條件使用的隱藏欄位 -->
          <field name="product_energy_type" invisible="1"/>
          <group>
            <group>
              <field name="order_date"/>
              <field name="sale_type"/>
              <field name="active"/>
            </group>
            <group>
              <field name="dealer_id"
                     attrs="{'invisible': [('sale_type', '!=', 'dealer')]}"/>
            </group>
          </group>

          <notebook>

            <!-- ===== Tab 1：客戶與車輛 ===== -->
            <page string="客戶與車輛">

              <group string="客戶資訊">
                <group>
                  <!-- 客戶姓名：必填，可直接填寫，不需預先建檔 -->
                  <field name="customer_name"/>
                  <field name="customer_phone"/>
                  <field name="id_number"/>
                  <field name="birthday_roc"/>
                </group>
                <group>
                  <field name="address_registered"/>
                  <!-- 已建檔客戶（可選）：選取後自動帶入以上欄位 -->
                  <field name="customer_id"
                         string="已建檔客戶（可選）"
                         options="{'no_create': False}"
                         help="選取已建檔客戶可自動帶入姓名、電話、身分證等資料；若客戶未建檔，可直接在上方欄位填寫資料。"/>
                </group>
              </group>

              <group string="車輛資訊">
                <group>
                  <field name="product_id"/>
                  <field name="color_id"
                         attrs="{'invisible': [('product_id', '=', False)]}"
                         options="{'no_create': True}"/>
                  <field name="engine_number"/>
                  <field name="frame_number"/>
                </group>
                <group>
                  <field name="plate_number"/>
                  <field name="registration_date"/>
                </group>
              </group>
            </page>

            <!-- ===== Tab 2：金流 ===== -->
            <page string="金流">
              <group string="售價">
                <group>
                  <field name="cash_price"/>
                  <field name="amount_total" string="總成交價"/>
                  <field name="cost"/>
                </group>
                <group>
                  <field name="payment_method"/>
                  <field name="finance_company"
                         attrs="{'invisible': [('payment_method', '!=', 'installment')]}"/>
                  <field name="installment_periods"
                         attrs="{'invisible': [('payment_method', '!=', 'installment')]}"/>
                  <field name="installment_monthly"
                         attrs="{'invisible': [('payment_method', '!=', 'installment')]}"/>
                </group>
              </group>

              <group string="付款狀態">
                <group>
                  <field name="deposit_amount"/>
                  <field name="balance_amount" readonly="1"/>
                </group>
                <group>
                  <field name="is_settled"/>
                  <field name="settle_date"
                         attrs="{'invisible': [('is_settled', '=', False)]}"/>
                </group>
              </group>

              <group string="車行金流"
                     attrs="{'invisible': [('sale_type', '!=', 'dealer')]}">
                <group>
                  <field name="dealer_amount"/>
                  <field name="commission"/>
                </group>
              </group>
            </page>

            <!-- ===== Tab 3：牌險費 ===== -->
            <page string="牌險費">

              <!-- 未選擇車款時提示 -->
              <div class="alert alert-secondary" role="alert"
                   attrs="{'invisible': [('product_id', '!=', False)]}">
                請先在「客戶與車輛」頁籤選擇車款後，系統將顯示對應的牌險費欄位。
              </div>

              <!-- ── 電車：自動帶入全部欄位 ── -->
              <div class="alert alert-info" role="alert"
                   attrs="{'invisible': [('product_energy_type', '!=', 'electric')]}">
                <strong>電車牌險費</strong>：已從費率表自動帶入，如有異動請手動調整。
              </div>
              <group attrs="{'invisible': [('product_energy_type', '!=', 'electric')]}">
                <group>
                  <field name="fee_vehicle_registration"/>
                  <field name="fee_inspection"/>
                  <field name="fee_plate"/>
                  <field name="fee_stamp"/>
                  <field name="fee_plate_selection"/>
                </group>
                <group>
                  <field name="fee_insurance"/>
                  <field name="fee_guild_cert"/>
                  <field name="fee_document"/>
                  <field name="fee_other"/>
                </group>
              </group>

              <!-- ── 油車：僅顯示 3 個必要欄位 ── -->
              <div class="alert alert-warning" role="alert"
                   attrs="{'invisible': [('product_energy_type', '!=', 'oil')]}">
                <strong>油車牌險費</strong>：請依監理站換發單據填入實際金額。
              </div>
              <group attrs="{'invisible': [('product_energy_type', '!=', 'oil')]}">
                <group>
                  <field name="fee_insurance"            string="強制險"/>
                  <field name="fee_vehicle_registration" string="領牌費"/>
                  <field name="fee_other"                string="其他"/>
                </group>
              </group>

              <!-- 合計（需已選車款） -->
              <group attrs="{'invisible': [('product_id', '=', False)]}">
                <field name="fee_total" readonly="1"/>
              </group>
            </page>

            <!-- ===== Tab 4：精品 ===== -->
            <page string="精品">
              <field name="order_line_ids">
                <tree editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="accessory_id"/>
                  <field name="unit_price"/>
                  <field name="install_fee"/>
                  <field name="quantity"/>
                  <field name="subtotal" readonly="1"/>
                </tree>
              </field>
            </page>

            <!-- ===== Tab 5：其他 ===== -->
            <page string="其他">
              <group>
                <group>
                  <field name="helmet_count"/>
                  <field name="gift_voucher"/>
                  <field name="gift_note"/>
                </group>
                <group>
                  <field name="special_plan"/>
                </group>
              </group>
              <group string="備註">
                <field name="note" nolabel="1"/>
              </group>
            </page>

          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_sale_order_search" model="ir.ui.view">
    <field name="name">dms.sale.order.search</field>
    <field name="model">dms.sale.order</field>
    <field name="arch" type="xml">
      <search string="搜尋銷售訂單">
        <field name="name"          string="訂單編號"/>
        <field name="customer_name" string="客戶姓名"/>
        <field name="customer_id"   string="已建檔客戶"/>
        <field name="id_number"     string="身分證字號"/>
        <field name="product_id"    string="車款"/>
        <field name="dealer_id"     string="車行"/>
        <field name="plate_number"  string="車牌"/>
        <field name="engine_number" string="引擎號碼"/>
        <field name="frame_number"  string="車身號碼"/>
        <separator/>
        <filter name="filter_store"  string="店面" domain="[('sale_type','=','store')]"/>
        <filter name="filter_dealer" string="車行" domain="[('sale_type','=','dealer')]"/>
        <separator/>
        <filter name="filter_draft"     string="草稿"   domain="[('state','=','draft')]"/>
        <filter name="filter_confirmed" string="確認"   domain="[('state','=','confirmed')]"/>
        <filter name="filter_cancel"    string="已取消" domain="[('state','=','cancel')]"/>
        <separator/>
        <filter name="filter_unsettled" string="未結清" domain="[('is_settled','=',False),('state','=','confirmed')]"/>
        <filter name="filter_settled"   string="已結清" domain="[('is_settled','=',True)]"/>
        <separator/>
        <filter name="filter_active"   string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_type"    string="交易類型" context="{'group_by': 'sale_type'}"/>
          <filter name="groupby_product" string="車款"     context="{'group_by': 'product_id'}"/>
          <filter name="groupby_dealer"  string="車行"     context="{'group_by': 'dealer_id'}"/>
          <filter name="groupby_month"   string="月份"     context="{'group_by': 'order_date:month'}"/>
          <filter name="groupby_settled" string="結清狀態" context="{'group_by': 'is_settled'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== Kanban 視圖 ===== -->
  <record id="view_sale_order_kanban" model="ir.ui.view">
    <field name="name">dms.sale.order.kanban</field>
    <field name="model">dms.sale.order</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile" sample="1">
        <field name="id"/>
        <field name="name"/>
        <field name="order_date"/>
        <field name="customer_name"/>
        <field name="product_id"/>
        <field name="amount_total"/>
        <field name="state"/>
        <field name="sale_type"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_card oe_kanban_global_click" style="padding:12px;">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <strong style="font-size:14px;">
                  <t t-esc="record.name.value"/>
                </strong>
                <span t-att-class="'badge ' + ({'draft':'badge-secondary','confirmed':'badge-success','cancel':'badge-danger'}[record.state.raw_value] || 'badge-secondary')">
                  <t t-esc="record.state.value"/>
                </span>
              </div>
              <div class="mt6" style="font-size:12px; color:#555;">
                <t t-if="record.customer_name.value">
                  <div><i class="fa fa-user-o"/> <t t-esc="record.customer_name.value"/></div>
                </t>
                <t t-if="record.product_id.value">
                  <div><i class="fa fa-motorcycle"/> <t t-esc="record.product_id.value"/></div>
                </t>
                <t t-if="record.order_date.value">
                  <div class="text-muted" style="font-size:11px; margin-top:4px;">
                    <t t-esc="record.order_date.value"/>
                  </div>
                </t>
              </div>
              <div class="mt4" style="font-size:13px; font-weight:600; color:#1a1a1a;">
                <t t-if="record.amount_total.raw_value">
                  NT$ <t t-esc="record.amount_total.value"/>
                </t>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_sale_order" model="ir.actions.act_window">
    <field name="name">銷售訂單</field>
    <field name="res_model">dms.sale.order</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_dms_sale_root" name="銷售管理" active="0"/>
  <menuitem id="menu_sale_order" name="銷售訂單" parent="menu_dms_sale_root"
            action="action_sale_order" sequence="10"/>

</odoo>
