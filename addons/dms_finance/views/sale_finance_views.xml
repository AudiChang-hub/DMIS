<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 財務結算 清單視圖 ===== -->
  <record id="view_sale_finance_tree" model="ir.ui.view">
    <field name="name">dms.sale.finance.tree</field>
    <field name="model">dms.sale.finance</field>
    <field name="arch" type="xml">
      <tree string="財務結算" decoration-danger="net_profit &lt; 0">
        <field name="sale_order_id"  optional="show"/>
        <field name="order_date"     optional="show"/>
        <field name="customer_name"  optional="show"/>
        <field name="total_income"   optional="show" sum="收入合計"/>
        <field name="total_expense"  optional="show" sum="支出合計"/>
        <field name="net_profit"     optional="show" sum="淨利合計"/>
      </tree>
    </field>
  </record>

  <!-- ===== 財務結算 表單視圖 ===== -->
  <record id="view_sale_finance_form" model="ir.ui.view">
    <field name="name">dms.sale.finance.form</field>
    <field name="model">dms.sale.finance</field>
    <field name="arch" type="xml">
      <form string="財務結算">
        <sheet>
          <div class="oe_title">
            <h1><field name="sale_order_id" readonly="1"/></h1>
          </div>

          <group>
            <group>
              <field name="sale_order_id"/>
            </group>
          </group>

          <notebook>

            <!-- ===== Tab 1：收入明細 ===== -->
            <page string="收入明細">
              <field name="income_ids">
                <tree editable="bottom">
                  <field name="category_id"/>
                  <field name="amount" sum="小計"/>
                  <field name="note"/>
                </tree>
              </field>
              <group>
                <group>
                  <field name="total_income" readonly="1"/>
                </group>
              </group>
            </page>

            <!-- ===== Tab 2：支出明細 ===== -->
            <page string="支出明細">
              <field name="expense_ids">
                <tree editable="bottom">
                  <field name="category_id"/>
                  <field name="amount" sum="小計"/>
                  <field name="note"/>
                </tree>
              </field>
              <group>
                <group>
                  <field name="total_expense" readonly="1"/>
                </group>
              </group>
            </page>

            <!-- ===== Tab 3：彙總 ===== -->
            <page string="彙總">
              <group string="淨利計算">
                <group>
                  <field name="total_income"  readonly="1"/>
                  <field name="total_expense" readonly="1"/>
                  <field name="net_profit"    readonly="1"/>
                </group>
              </group>
              <group string="備註">
                <field name="note" nolabel="1"/>
              </group>
            </page>

          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 財務結算 搜尋視圖 ===== -->
  <record id="view_sale_finance_search" model="ir.ui.view">
    <field name="name">dms.sale.finance.search</field>
    <field name="model">dms.sale.finance</field>
    <field name="arch" type="xml">
      <search string="搜尋財務結算">
        <field name="sale_order_id" string="銷售訂單"/>
        <separator/>
        <filter name="filter_profit_positive" string="有淨利"
                domain="[('net_profit', '&gt;', 0)]"/>
        <filter name="filter_profit_negative" string="虧損"
                domain="[('net_profit', '&lt;', 0)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_order" string="銷售訂單"
                  context="{'group_by': 'sale_order_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== Kanban 視圖 ===== -->
  <record id="view_sale_finance_kanban" model="ir.ui.view">
    <field name="name">dms.sale.finance.kanban</field>
    <field name="model">dms.sale.finance</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile" sample="1">
        <field name="id"/>
        <field name="sale_order_id"/>
        <field name="customer_name"/>
        <field name="total_income"/>
        <field name="total_expense"/>
        <field name="net_profit"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_card oe_kanban_global_click" style="padding:12px;">
              <strong style="font-size:14px;">
                <t t-esc="record.sale_order_id.value"/>
              </strong>
              <t t-if="record.customer_name.value">
                <div class="text-muted" style="font-size:12px; margin-top:4px;">
                  <t t-esc="record.customer_name.value"/>
                </div>
              </t>
              <div class="mt8" style="display:flex; gap:8px; flex-wrap:wrap;">
                <span style="font-size:12px; color:#28a745;">
                  收入&#160;<strong><t t-esc="record.total_income.value"/></strong>
                </span>
                <span style="font-size:12px; color:#dc3545;">
                  支出&#160;<strong><t t-esc="record.total_expense.value"/></strong>
                </span>
              </div>
              <div class="mt4" style="font-size:13px; font-weight:700;"
                   t-att-style="'font-size:13px; font-weight:700; color:' + (record.net_profit.raw_value >= 0 ? '#28a745' : '#dc3545') + ';'">
                淨利&#160;<t t-esc="record.net_profit.value"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_dms_sale_finance" model="ir.actions.act_window">
    <field name="name">財務結算</field>
    <field name="res_model">dms.sale.finance</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_dms_finance_root" name="財務結算" sequence="30"/>
  <menuitem id="menu_dms_finance_list" name="財務結算"
            parent="menu_dms_finance_root"
            action="action_dms_sale_finance" sequence="10"/>

</odoo>
