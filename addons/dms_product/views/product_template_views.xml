<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_product_template_tree" model="ir.ui.view">
    <field name="name">dms.product.template.tree</field>
    <field name="model">dms.product.template</field>
    <field name="arch" type="xml">
      <tree string="產品頁面">
        <field name="brand_id" optional="show"/>
        <field name="family_name" optional="show"/>
        <field name="type_name" optional="show"/>
        <field name="model_name" optional="show"/>
        <field name="energy_type" optional="show"/>
        <field name="sku_count" optional="show"/>
        <field name="active" optional="show"/>
      </tree>
    </field>
  </record>

  <record id="view_product_template_form" model="ir.ui.view">
    <field name="name">dms.product.template.form</field>
    <field name="model">dms.product.template</field>
    <field name="arch" type="xml">
      <form string="產品頁面">
        <header>
          <button string="💾 儲存" special="save" class="btn-success"
                  title="儲存目前所有填寫的資料"/>
        </header>
        <sheet>
          <div class="alert alert-info" role="alert"
               attrs="{'invisible': [('id', '!=', False)]}">
            <strong>新增產品</strong>：請先填寫品牌、機種、能源型式後，點擊上方綠色「儲存」按鈕，即可在下方新增及複製產品項。
          </div>
          <group>
            <group>
              <field name="brand_id"/>
              <field name="family_name"/>
              <field name="type_name"/>
              <field name="model_name"/>
            </group>
            <group>
              <field name="energy_type"/>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="產品項">
              <field name="sku_ids"
                     context="{'default_template_id': id, 'active_test': False}">
                <tree decoration-muted="not active" no_open="True">
                  <button name="action_open_installment_dialog"
                          type="object"
                          icon="fa-external-link"
                          string="開啟"
                          title="開啟定價 / 分期 / 日誌"/>
                  <button name="action_duplicate_from_template_tab"
                          type="object"
                          icon="fa-copy"
                          string="複製"
                          class="btn-secondary"
                          title="複製此產品項（年份將清空，填寫新年份後按「儲存」即完成）"/>
                  <field name="internal_code" readonly="1"/>
                  <field name="production_year" readonly="1"/>
                  <field name="color" string="顏色" readonly="1"/>
                  <field name="cash_price" string="現金售價" readonly="1" optional="show"/>
                  <field name="list_price" string="牌價" readonly="1" optional="show"/>
                  <field name="promo_price" string="活動特殊價" readonly="1" optional="show"/>
                  <field name="effective_price" string="有效售價" readonly="1" optional="show"/>
                  <field name="active" readonly="1"/>
                </tree>
              </field>
            </page>
            <page string="備註">
              <field name="note" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_product_template_search" model="ir.ui.view">
    <field name="name">dms.product.template.search</field>
    <field name="model">dms.product.template</field>
    <field name="arch" type="xml">
      <search string="搜尋產品頁面">
        <field name="brand_id"/>
        <field name="family_name"/>
        <field name="type_name"/>
        <field name="model_name"/>
        <filter name="filter_active" string="啟用中" domain="[('active', '=', True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active', '=', False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_brand" string="品牌" context="{'group_by': 'brand_id'}"/>
          <filter name="groupby_energy" string="能源型式" context="{'group_by': 'energy_type'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_product_template" model="ir.actions.act_window">
    <field name="name">產品頁面</field>
    <field name="res_model">dms.product.template</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <record id="action_product_template_duplicate" model="ir.actions.server">
    <field name="name">複製</field>
    <field name="model_id" ref="model_dms_product_template"/>
    <field name="binding_model_id" ref="model_dms_product_template"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">
copies = env['dms.product.template']
for record in records:
    copies |= record.copy()
if len(copies) == 1:
    action = {
        'type': 'ir.actions.act_window',
        'res_model': 'dms.product.template',
        'res_id': copies.id,
        'view_mode': 'form',
        'target': 'current',
    }
    </field>
  </record>

</odoo>
