<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_installment_rule_tree" model="ir.ui.view">
    <field name="name">dms.installment.rule.tree</field>
    <field name="model">dms.installment.rule</field>
    <field name="arch" type="xml">
      <tree string="分期規則">
        <field name="name"            optional="show"/>
        <field name="finance_company" optional="show"/>
        <field name="active"          optional="show"/>
        <field name="note"            optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_installment_rule_form" model="ir.ui.view">
    <field name="name">dms.installment.rule.form</field>
    <field name="model">dms.installment.rule</field>
    <field name="arch" type="xml">
      <form string="分期規則範本">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="規則名稱"/></h1>
          </div>
          <group>
            <group>
              <field name="finance_company"/>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="分期明細">
              <field name="line_ids">
                <tree editable="bottom" expand="1">
                  <field name="periods"/>
                  <field name="monthly_payment"/>
                  <field name="fee_ids" widget="many2many_tags" optional="hide"/>
                </tree>
              </field>
            </page>
            <page string="備註">
              <field name="note" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_installment_rule_search" model="ir.ui.view">
    <field name="name">dms.installment.rule.search</field>
    <field name="model">dms.installment.rule</field>
    <field name="arch" type="xml">
      <search string="搜尋分期規則">
        <field name="name" string="規則名稱"/>
        <field name="finance_company" string="分期公司"/>
        <separator/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
      </search>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_installment_rule" model="ir.actions.act_window">
    <field name="name">分期規則</field>
    <field name="res_model">dms.installment.rule</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_filter_active': 1}</field>
  </record>

</odoo>
