<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== Tree View ===== -->
  <record id="view_product_tree" model="ir.ui.view">
    <field name="name">dms.product.tree</field>
    <field name="model">dms.product</field>
    <field name="arch" type="xml">
      <tree string="產品清單">
        <!-- 預設顯示（optional="show"）-->
        <field name="brand_id"    optional="show"/>
        <field name="name"        optional="show"/>
        <field name="model"       optional="show"/>
        <field name="year"        optional="show"/>
        <field name="brake_type"  optional="show"/>
        <field name="energy_type" optional="show"/>
        <field name="color"       optional="show"/>
        <field name="color_code"  optional="hide"/>
        <field name="active"      optional="show"/>
        <!-- 動力規格（油車）— 預設隱藏 -->
        <field name="engine_displacement" optional="hide"/>
        <field name="fuel_tank"           optional="hide"/>
        <field name="engine_type"         optional="hide"/>
        <field name="consumption_grade"   optional="hide"/>
        <field name="efficiency"          optional="hide"/>
        <field name="max_hp"              optional="hide"/>
        <field name="max_torque"          optional="hide"/>
        <!-- 動力規格（電車）— 預設隱藏 -->
        <field name="power_system"     optional="hide"/>
        <field name="max_output"       optional="hide"/>
        <field name="ev_max_hp"        optional="hide"/>
        <field name="ev_max_torque"    optional="hide"/>
        <field name="ev_efficiency"    optional="hide"/>
        <field name="transmission"     optional="hide"/>
        <field name="battery_capacity" optional="hide"/>
        <field name="battery_type"     optional="hide"/>
        <field name="charge_time"      optional="hide"/>
        <!-- 車身規格 — 預設隱藏 -->
        <field name="dimensions"      optional="hide"/>
        <field name="seat_height"     optional="hide"/>
        <field name="wheel_base"      optional="hide"/>
        <field name="vehicle_weight"  optional="hide"/>
        <field name="tire_front"      optional="hide"/>
        <field name="tire_rear"       optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== Form View ===== -->
  <record id="view_product_form" model="ir.ui.view">
    <field name="name">dms.product.form</field>
    <field name="model">dms.product</field>
    <field name="arch" type="xml">
      <form string="產品">
        <sheet>
          <div class="oe_button_box" name="button_box"/>
          <!-- 圖片區塊（右上角）-->
          <field name="image_1920" widget="image"
                 class="oe_avatar"
                 options="{'zoom': true, 'preview_image': 'image_128'}"/>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="產品名稱"/></h1>
          </div>
          <notebook>
            <!-- 頁籤1：基本資料 -->
            <page string="基本資料">
              <group>
                <field name="brand_id"/>
                <field name="name"/>
                <field name="model"/>
                <field name="year"/>
                <field name="brake_type"/>
                <field name="energy_type"/>
                <field name="color"/>
                <field name="color_code"/>
                <field name="active"/>
              </group>
            </page>

            <!-- 頁籤2：動力規格（油車）— 僅 energy_type == 'oil' 時顯示 -->
            <page string="動力規格(油車)"
                  attrs="{'invisible': [('energy_type', '!=', 'oil')]}">
              <group>
                <field name="engine_displacement"/>
                <field name="fuel_tank"/>
                <field name="engine_type"/>
                <field name="consumption_grade"/>
                <field name="efficiency"/>
                <field name="max_hp"/>
                <field name="max_torque"/>
              </group>
            </page>

            <!-- 頁籁4：動力規格（電車）— 僅 energy_type == 'electric' 時顯示 -->
            <page string="動力規格(電車)"
                  attrs="{'invisible': [('energy_type', '!=', 'electric')]}">
              <group>
                <field name="power_system"/>
                <field name="max_output"/>
                <field name="ev_max_hp"/>
                <field name="ev_max_torque"/>
                <field name="ev_efficiency"/>
                <field name="transmission"/>
                <field name="battery_capacity"/>
                <field name="battery_type"/>
                <field name="charge_time"/>
              </group>
            </page>

            <!-- 頁籤4：車身規格（永遠顯示） -->
            <page string="車身規格">
              <group>
                <field name="dimensions"/>
                <field name="seat_height"/>
                <field name="wheel_base"/>
                <field name="vehicle_weight"/>
                <field name="tire_front"/>
                <field name="tire_rear"/>
              </group>
            </page>

            <!-- 頁籤5：車輛圖片 -->
            <page string="車輛圖片">
              <div class="dms-product-img-page">
                <field name="image_1920" widget="image"
                       class="dms-product-img-full"
                       options="{'zoom': true}"/>
              </div>
            </page>

          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== Kanban View ===== -->
  <record id="view_product_kanban" model="ir.ui.view">
    <field name="name">dms.product.kanban</field>
    <field name="model">dms.product</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile" sample="1">
        <field name="id"/>
        <field name="name"/>
        <field name="brand_id"/>
        <field name="brand_logo"/>
        <field name="model"/>
        <field name="year"/>
        <field name="energy_type"/>
        <field name="color"/>
        <field name="color_code"/>
        <field name="active"/>
        <field name="brake_type"/>
        <field name="engine_displacement"/>
        <field name="fuel_tank"/>
        <field name="engine_type"/>
        <field name="consumption_grade"/>
        <field name="efficiency"/>
        <field name="max_hp"/>
        <field name="max_torque"/>
        <field name="power_system"/>
        <field name="max_output"/>
        <field name="ev_max_hp"/>
        <field name="ev_max_torque"/>
        <field name="ev_efficiency"/>
        <field name="transmission"/>
        <field name="battery_capacity"/>
        <field name="battery_type"/>
        <field name="charge_time"/>
        <field name="dimensions"/>
        <field name="seat_height"/>
        <field name="wheel_base"/>
        <field name="vehicle_weight"/>
        <field name="tire_front"/>
        <field name="tire_rear"/>
        <field name="kanban_cfg_model"/>
        <field name="kanban_cfg_year"/>
        <field name="kanban_cfg_brake_type"/>
        <field name="kanban_cfg_energy_type"/>
        <field name="kanban_cfg_color"/>
        <field name="kanban_cfg_color_code"/>
        <field name="kanban_cfg_engine_displacement"/>
        <field name="kanban_cfg_fuel_tank"/>
        <field name="kanban_cfg_engine_type"/>
        <field name="kanban_cfg_consumption_grade"/>
        <field name="kanban_cfg_efficiency"/>
        <field name="kanban_cfg_max_hp"/>
        <field name="kanban_cfg_max_torque"/>
        <field name="kanban_cfg_power_system"/>
        <field name="kanban_cfg_max_output"/>
        <field name="kanban_cfg_ev_max_hp"/>
        <field name="kanban_cfg_ev_max_torque"/>
        <field name="kanban_cfg_ev_efficiency"/>
        <field name="kanban_cfg_transmission"/>
        <field name="kanban_cfg_battery_capacity"/>
        <field name="kanban_cfg_battery_type"/>
        <field name="kanban_cfg_charge_time"/>
        <field name="kanban_cfg_dimensions"/>
        <field name="kanban_cfg_seat_height"/>
        <field name="kanban_cfg_wheel_base"/>
        <field name="kanban_cfg_vehicle_weight"/>
        <field name="kanban_cfg_tire_front"/>
        <field name="kanban_cfg_tire_rear"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_card oe_kanban_global_click dms-product-kanban-card">
              <div class="dms-product-kanban-body">
                <!-- 品牌名 + Logo 右上角 + 產品名 -->
                <div class="dms-product-kanban-header">
                  <div class="dms-product-kanban-header-left">
                    <span class="dms-product-kanban-brand text-muted">
                      <t t-esc="record.brand_id.value"/>
                    </span>
                    <strong class="dms-product-kanban-name">
                      <t t-esc="record.name.value"/>
                    </strong>
                  </div>
                  <t t-if="record.brand_logo.raw_value">
                    <img t-att-src="'/web/image/dms.brand/' + record.brand_id.raw_value + '/image_128'"
                         class="dms-product-kanban-brand-logo"
                         alt=""/>
                  </t>
                </div>
                <!-- 可設定欄位 -->
                <div class="dms-product-kanban-fields">
                  <t t-if="record.kanban_cfg_model.raw_value and record.model.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">型號</span>
                      <span class="dms-field-val"><t t-esc="record.model.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_year.raw_value and record.year.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">年份</span>
                      <span class="dms-field-val"><t t-esc="record.year.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_brake_type.raw_value and record.brake_type.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">煞車型式</span>
                      <span class="dms-field-val"><t t-esc="record.brake_type.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_energy_type.raw_value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">能源</span>
                      <span t-att-class="'badge ' + (record.energy_type.raw_value === 'oil' ? 'badge-warning' : 'badge-success')">
                        <t t-esc="record.energy_type.value"/>
                      </span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_color.raw_value and record.color.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">顏色</span>
                      <span class="dms-field-val"><t t-esc="record.color.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_color_code.raw_value and record.color_code.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">色碼</span>
                      <span class="dms-field-val"><t t-esc="record.color_code.value"/></span>
                    </span>
                  </t>
                  <!-- 油車規格 -->
                  <t t-if="record.kanban_cfg_engine_displacement.raw_value and record.engine_displacement.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">排氣量</span>
                      <span class="dms-field-val"><t t-esc="record.engine_displacement.value"/> cc</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_fuel_tank.raw_value and record.fuel_tank.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">油箱</span>
                      <span class="dms-field-val"><t t-esc="record.fuel_tank.value"/> L</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_engine_type.raw_value and record.engine_type.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">引擎型式</span>
                      <span class="dms-field-val"><t t-esc="record.engine_type.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_consumption_grade.raw_value and record.consumption_grade.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">能耗等級</span>
                      <span class="dms-field-val"><t t-esc="record.consumption_grade.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_efficiency.raw_value and record.efficiency.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">油耗</span>
                      <span class="dms-field-val"><t t-esc="record.efficiency.value"/> km/L</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_max_hp.raw_value and record.max_hp.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">馬力</span>
                      <span class="dms-field-val"><t t-esc="record.max_hp.value"/> hp</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_max_torque.raw_value and record.max_torque.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">扭力</span>
                      <span class="dms-field-val"><t t-esc="record.max_torque.value"/> Nm</span>
                    </span>
                  </t>
                  <!-- 電車規格 -->
                  <t t-if="record.kanban_cfg_power_system.raw_value and record.power_system.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">動力系統</span>
                      <span class="dms-field-val"><t t-esc="record.power_system.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_max_output.raw_value and record.max_output.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">最大功率</span>
                      <span class="dms-field-val"><t t-esc="record.max_output.value"/> kW</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_ev_max_hp.raw_value and record.ev_max_hp.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">馬力 EV</span>
                      <span class="dms-field-val"><t t-esc="record.ev_max_hp.value"/> hp</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_ev_max_torque.raw_value and record.ev_max_torque.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">扭力 EV</span>
                      <span class="dms-field-val"><t t-esc="record.ev_max_torque.value"/> Nm</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_ev_efficiency.raw_value and record.ev_efficiency.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">電耗</span>
                      <span class="dms-field-val"><t t-esc="record.ev_efficiency.value"/> kWh/km</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_transmission.raw_value and record.transmission.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">傳動</span>
                      <span class="dms-field-val"><t t-esc="record.transmission.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_battery_capacity.raw_value and record.battery_capacity.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">電池</span>
                      <span class="dms-field-val"><t t-esc="record.battery_capacity.value"/> kWh</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_battery_type.raw_value and record.battery_type.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">電池型式</span>
                      <span class="dms-field-val"><t t-esc="record.battery_type.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_charge_time.raw_value and record.charge_time.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">充電時間</span>
                      <span class="dms-field-val"><t t-esc="record.charge_time.value"/> hr</span>
                    </span>
                  </t>
                  <!-- 車身規格 -->
                  <t t-if="record.kanban_cfg_dimensions.raw_value and record.dimensions.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">尺寸</span>
                      <span class="dms-field-val"><t t-esc="record.dimensions.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_seat_height.raw_value and record.seat_height.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">座高</span>
                      <span class="dms-field-val"><t t-esc="record.seat_height.value"/> mm</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_wheel_base.raw_value and record.wheel_base.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">軸距</span>
                      <span class="dms-field-val"><t t-esc="record.wheel_base.value"/> mm</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_vehicle_weight.raw_value and record.vehicle_weight.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">車重</span>
                      <span class="dms-field-val"><t t-esc="record.vehicle_weight.value"/> kg</span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_tire_front.raw_value and record.tire_front.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">前輪</span>
                      <span class="dms-field-val"><t t-esc="record.tire_front.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_tire_rear.raw_value and record.tire_rear.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">後輪</span>
                      <span class="dms-field-val"><t t-esc="record.tire_rear.value"/></span>
                    </span>
                  </t>
                </div>
                <!-- 停用 badge -->
                <t t-if="!record.active.raw_value">
                  <span class="badge badge-danger mt4">停用</span>
                </t>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- ===== Search View ===== -->
  <record id="view_product_search" model="ir.ui.view">
    <field name="name">dms.product.search</field>
    <field name="model">dms.product</field>
    <field name="arch" type="xml">
      <search string="搜尋產品">
        <field name="name" string="名稱"/>
        <field name="model" string="型號"/>
        <field name="brand_id" string="品牌"/>
        <separator/>
        <filter name="filter_oil" string="油車" domain="[('energy_type', '=', 'oil')]"/>
        <filter name="filter_electric" string="電車" domain="[('energy_type', '=', 'electric')]"/>
        <filter name="filter_active" string="啟用中" domain="[('active', '=', True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active', '=', False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_brand" string="品牌" context="{'group_by': 'brand_id'}"/>
          <filter name="groupby_energy" string="能源型式" context="{'group_by': 'energy_type'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== Action ===== -->
  <record id="action_product" model="ir.actions.act_window">
    <field name="name">產品管理</field>
    <field name="res_model">dms.product</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <!-- 頂層：與 DMS Core 並列，出現在 Odoo 首頁 App 列 -->
  <menuitem id="menu_dms_product_root" name="產品管理" sequence="30"/>
  <menuitem id="menu_product" name="產品管理" parent="menu_dms_product_root"
            action="action_product" sequence="10"/>

</odoo>
