<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_brand_rule_unmatched_wizard_form" model="ir.ui.view">
        <field name="name">dms.dealer.brand.rule.unmatched.wizard.form</field>
        <field name="model">dms.dealer.brand.rule.unmatched.wizard</field>
        <field name="arch" type="xml">
            <form string="brand_type 未命中診斷">
                <group>
                    <field name="summary" nolabel="1" readonly="1"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <tree create="false" delete="false" edit="false">
                        <field name="dname"/>
                        <field name="order_count"/>
                    </tree>
                </field>
                <footer>
                    <button string="關閉" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_diagnose_brand_unmatched" model="ir.actions.server">
        <field name="name">診斷 brand_type 未命中</field>
        <field name="model_id" ref="model_dms_dealer_brand_rule_unmatched_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <menuitem id="menu_diagnose_brand_unmatched"
              name="診斷 brand_type 未命中"
              parent="dms_report.menu_dms_report_root"
              action="action_diagnose_brand_unmatched"
              sequence="62"/>

    <record id="action_diagnose_motor_unmatched" model="ir.actions.server">
        <field name="name">診斷 motor_type 未命中</field>
        <field name="model_id" ref="model_dms_dealer_brand_rule_unmatched_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_motor()</field>
    </record>

    <menuitem id="menu_diagnose_motor_unmatched"
              name="診斷 motor_type 未命中"
              parent="dms_report.menu_dms_report_root"
              action="action_diagnose_motor_unmatched"
              sequence="63"/>

</odoo>
