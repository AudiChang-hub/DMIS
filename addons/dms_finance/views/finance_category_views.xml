<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 財務類別 清單視圖 ===== -->
  <record id="view_finance_category_tree" model="ir.ui.view">
    <field name="name">dms.finance.category.tree</field>
    <field name="model">dms.finance.category</field>
    <field name="arch" type="xml">
      <tree string="財務類別">
        <field name="sequence" widget="handle"/>
        <field name="code"     optional="show"/>
        <field name="name"     optional="show"/>
        <field name="type"     optional="show"/>
        <field name="active"   optional="show"/>
      </tree>
    </field>
  </record>

  <!-- ===== 財務類別 表單視圖 ===== -->
  <record id="view_finance_category_form" model="ir.ui.view">
    <field name="name">dms.finance.category.form</field>
    <field name="model">dms.finance.category</field>
    <field name="arch" type="xml">
      <form string="財務類別">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="type"/>
            </group>
            <group>
              <field name="sequence"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_finance_category" model="ir.actions.act_window">
    <field name="name">財務類別管理</field>
    <field name="res_model">dms.finance.category</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單（財務結算主選單下）===== -->
  <menuitem id="menu_finance_category" name="類別管理"
            parent="menu_dms_finance_root"
            action="action_finance_category" sequence="20"/>

</odoo>
