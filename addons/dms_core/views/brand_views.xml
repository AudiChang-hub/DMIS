<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_brand_tree" model="ir.ui.view">
    <field name="name">dms.brand.tree</field>
    <field name="model">dms.brand</field>
    <field name="arch" type="xml">
      <tree string="品牌">
        <field name="name"/>
        <field name="active" optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_brand_form" model="ir.ui.view">
    <field name="name">dms.brand.form</field>
    <field name="model">dms.brand</field>
    <field name="arch" type="xml">
      <form string="品牌">
        <sheet>
          <group>
            <field name="name"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_brand" model="ir.actions.act_window">
    <field name="name">品牌</field>
    <field name="res_model">dms.brand</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_brands" name="品牌" parent="menu_dms_root"
            action="action_brand" sequence="20"/>

</odoo>
