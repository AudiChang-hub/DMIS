<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_brand_tree" model="ir.ui.view">
    <field name="name">dms.brand.tree</field>
    <field name="model">dms.brand</field>
    <field name="arch" type="xml">
      <tree string="品牌">
        <field name="image_128" widget="image" string="Logo" optional="show" options="{'size': [40, 40]}"/>
        <field name="name"   optional="show"/>
        <field name="active" optional="show"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_brand_form" model="ir.ui.view">
    <field name="name">dms.brand.form</field>
    <field name="model">dms.brand</field>
    <field name="arch" type="xml">
      <form string="品牌">
        <sheet>
          <field name="image_1920" widget="image"
                 class="oe_avatar"
                 options="{'zoom': true, 'preview_image': 'image_128'}"/>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="品牌名稱"/></h1>
          </div>
          <group>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_brand_search" model="ir.ui.view">
    <field name="name">dms.brand.search</field>
    <field name="model">dms.brand</field>
    <field name="arch" type="xml">
      <search string="搜尋品牌">
        <field name="name" string="品牌名稱"/>
        <separator/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
      </search>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_brand" model="ir.actions.act_window">
    <field name="name">品牌</field>
    <field name="res_model">dms.brand</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_brands" name="品牌" parent="menu_dms_root"
            action="action_brand" sequence="20"/>

</odoo>
