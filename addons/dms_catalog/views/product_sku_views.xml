<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_product_sku_tree" model="ir.ui.view">
    <field name="name">dms.product.sku.tree</field>
    <field name="model">dms.product.sku</field>
    <field name="arch" type="xml">
      <tree string="SKU">
        <field name="template_id"      optional="show"/>
        <field name="color"            optional="show"/>
        <field name="color_code"       optional="show"/>
        <field name="manufacture_year" optional="show"/>
        <field name="sku_code"         optional="show"/>
        <field name="active"           optional="show"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_product_sku_form" model="ir.ui.view">
    <field name="name">dms.product.sku.form</field>
    <field name="model">dms.product.sku</field>
    <field name="arch" type="xml">
      <form string="SKU">
        <sheet>
          <field name="image_1920" widget="image" class="oe_avatar"/>
          <div class="oe_title">
            <label for="display_name"/>
            <h1><field name="display_name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="template_id"/>
              <field name="color"/>
              <field name="color_code"/>
              <field name="manufacture_year"/>
              <field name="sku_code"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_product_sku_search" model="ir.ui.view">
    <field name="name">dms.product.sku.search</field>
    <field name="model">dms.product.sku</field>
    <field name="arch" type="xml">
      <search string="搜尋 SKU">
        <field name="template_id" string="型式"/>
        <field name="color" string="顏色"/>
        <field name="sku_code" string="SKU 代碼"/>
        <separator/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_template" string="型式" context="{'group_by': 'template_id'}"/>
          <filter name="groupby_year" string="年份" context="{'group_by': 'manufacture_year'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_product_sku" model="ir.actions.act_window">
    <field name="name">SKU 管理</field>
    <field name="res_model">dms.product.sku</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_filter_active': 1}</field>
  </record>

</odoo>
