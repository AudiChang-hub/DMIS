<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_ev_fee_schedule_tree" model="ir.ui.view">
    <field name="name">dms.ev.fee.schedule.tree</field>
    <field name="model">dms.ev.fee.schedule</field>
    <field name="arch" type="xml">
      <tree string="電車牌險費率">
        <field name="product_template_id" optional="show"/>
        <field name="fee_total"           optional="show"/>
        <field name="valid_from"          optional="show"/>
        <field name="valid_to"            optional="show"/>
        <field name="active"              optional="show"/>
        <field name="note"                optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_ev_fee_schedule_form" model="ir.ui.view">
    <field name="name">dms.ev.fee.schedule.form</field>
    <field name="model">dms.ev.fee.schedule</field>
    <field name="arch" type="xml">
      <form string="電車牌險費率">
        <sheet>
          <group>
            <group>
              <field name="product_template_id"/>
              <field name="active"/>
            </group>
            <group>
              <field name="valid_from"/>
              <field name="valid_to"/>
            </group>
          </group>
          <group string="費用明細">
            <group>
              <field name="fee_vehicle_registration"/>
              <field name="fee_inspection"/>
              <field name="fee_plate"/>
              <field name="fee_stamp"/>
              <field name="fee_insurance"/>
            </group>
            <group>
              <field name="fee_guild_cert"/>
              <field name="fee_document"/>
              <field name="fee_other"/>
              <field name="fee_total" readonly="1"/>
            </group>
          </group>
          <group>
            <field name="note" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_ev_fee_schedule_search" model="ir.ui.view">
    <field name="name">dms.ev.fee.schedule.search</field>
    <field name="model">dms.ev.fee.schedule</field>
    <field name="arch" type="xml">
      <search string="搜尋電車牌險費率">
        <field name="product_template_id" string="車款型式"/>
        <separator/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_product" string="車款型式"
                  context="{'group_by': 'product_template_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_ev_fee_schedule" model="ir.actions.act_window">
    <field name="name">電車牌險費率</field>
    <field name="res_model">dms.ev.fee.schedule</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_filter_active': 1}</field>
  </record>

</odoo>
