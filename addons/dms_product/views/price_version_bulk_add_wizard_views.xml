<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_price_version_bulk_add_wizard_form" model="ir.ui.view">
    <field name="name">dms.price.version.bulk.add.wizard.form</field>
    <field name="model">dms.price.version.bulk.add.wizard</field>
    <field name="arch" type="xml">
      <form string="批次加入產品項">
        <sheet>
          <group>
            <field name="version_id"/>
            <field name="existing_product_ids" invisible="1"/>
          </group>
          <group>
            <group>
              <field name="cash_price"/>
              <field name="list_price"/>
            </group>
          </group>
          <group>
            <field name="product_ids"
                   string="產品項"
                   widget="many2many_tags"
                   options="{'no_create': True, 'no_create_edit': True}"/>
          </group>
          <footer>
            <button name="action_add_lines" type="object" string="加入價格列" class="btn-primary"/>
            <button string="取消" special="cancel" class="btn-secondary"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

</odoo>
