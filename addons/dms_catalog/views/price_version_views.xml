<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_price_version_tree" model="ir.ui.view">
    <field name="name">dms.price.version.tree</field>
    <field name="model">dms.price.version</field>
    <field name="arch" type="xml">
      <tree string="定價版本">
        <field name="name"           optional="show"/>
        <field name="effective_date" optional="show"/>
        <field name="state"          optional="show"/>
        <field name="note"           optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_price_version_form" model="ir.ui.view">
    <field name="name">dms.price.version.form</field>
    <field name="model">dms.price.version</field>
    <field name="arch" type="xml">
      <form string="定價版本">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="版本名稱"/></h1>
          </div>
          <group>
            <group>
              <field name="effective_date"/>
              <field name="state" widget="statusbar"
                     statusbar_visible="draft,active,archived"/>
            </group>
          </group>
          <notebook>
            <page string="定價明細">
              <field name="line_ids">
                <tree editable="bottom">
                  <field name="sku_id"/>
                  <field name="cash_price"/>
                  <field name="list_price"/>
                  <field name="is_promotion"/>
                  <field name="installment_rule_ids" widget="many2many_tags"/>
                  <field name="note" optional="hide"/>
                </tree>
              </field>
            </page>
            <page string="備註">
              <field name="note" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_price_version_search" model="ir.ui.view">
    <field name="name">dms.price.version.search</field>
    <field name="model">dms.price.version</field>
    <field name="arch" type="xml">
      <search string="搜尋定價版本">
        <field name="name" string="版本名稱"/>
        <separator/>
        <filter name="filter_draft" string="草稿" domain="[('state','=','draft')]"/>
        <filter name="filter_active" string="有效" domain="[('state','=','active')]"/>
        <filter name="filter_archived" string="封存" domain="[('state','=','archived')]"/>
        <group expand="0" string="分組">
          <filter name="groupby_state" string="狀態" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_price_version" model="ir.actions.act_window">
    <field name="name">定價版本</field>
    <field name="res_model">dms.price.version</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
