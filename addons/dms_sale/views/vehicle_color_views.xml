<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- 清單視圖 -->
  <record id="view_vehicle_color_tree" model="ir.ui.view">
    <field name="name">dms.vehicle.color.tree</field>
    <field name="model">dms.vehicle.color</field>
    <field name="arch" type="xml">
      <tree string="車款顏色">
        <field name="product_id"  optional="show"/>
        <field name="sequence"    optional="hide" widget="handle"/>
        <field name="name"        optional="show"/>
        <field name="active"      optional="show"/>
      </tree>
    </field>
  </record>

  <!-- 表單視圖 -->
  <record id="view_vehicle_color_form" model="ir.ui.view">
    <field name="name">dms.vehicle.color.form</field>
    <field name="model">dms.vehicle.color</field>
    <field name="arch" type="xml">
      <form string="車款顏色">
        <sheet>
          <group>
            <group>
              <field name="product_id"/>
              <field name="name"/>
            </group>
            <group>
              <field name="sequence"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- 搜尋視圖 -->
  <record id="view_vehicle_color_search" model="ir.ui.view">
    <field name="name">dms.vehicle.color.search</field>
    <field name="model">dms.vehicle.color</field>
    <field name="arch" type="xml">
      <search string="搜尋顏色">
        <field name="name"       string="顏色名稱"/>
        <field name="product_id" string="車款"/>
        <filter name="active"   string="啟用中" domain="[('active','=',True)]"/>
        <filter name="archived" string="已歸檔" domain="[('active','=',False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_product" string="車款" context="{'group_by': 'product_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- 動作 -->
  <record id="action_vehicle_color" model="ir.actions.act_window">
    <field name="name">車款顏色</field>
    <field name="res_model">dms.vehicle.color</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- 選單（掛在 DMS 銷售管理底下） -->
  <menuitem id="menu_vehicle_color" name="車款顏色設定"
            parent="menu_dms_sale_root"
            action="action_vehicle_color" sequence="90"/>

</odoo>
