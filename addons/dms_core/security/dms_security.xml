<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_dms" model="ir.module.category">
    <field name="name">車行管理系統</field>
    <field name="sequence">100</field>
  </record>

  <record id="group_dms_dealer_user" model="res.groups">
    <field name="name">DMS/車行使用者</field>
    <field name="category_id" ref="module_category_dms"/>
  </record>

  <record id="group_dms_dealer_manager" model="res.groups">
    <field name="name">DMS/車行管理者</field>
    <field name="category_id" ref="module_category_dms"/>
    <field name="implied_ids" eval="[(4, ref('group_dms_dealer_user'))]"/>
  </record>
</odoo>
