<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_accessory_tree" model="ir.ui.view">
    <field name="name">dms.accessory.tree</field>
    <field name="model">dms.accessory</field>
    <field name="arch" type="xml">
      <tree string="精品售價">
        <field name="name"         optional="show"/>
        <field name="model_number" optional="show"/>
        <field name="unit_price"   optional="show"/>
        <field name="install_fee"  optional="hide"/>
        <field name="bundle_name"  optional="hide"/>
        <field name="valid_from"   optional="hide"/>
        <field name="valid_to"     optional="hide"/>
        <field name="active"       optional="show"/>
        <field name="note"         optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_accessory_form" model="ir.ui.view">
    <field name="name">dms.accessory.form</field>
    <field name="model">dms.accessory</field>
    <field name="arch" type="xml">
      <form string="精品售價">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="model_number"/>
              <field name="active"/>
            </group>
            <group>
              <field name="unit_price"/>
              <field name="install_fee"/>
              <field name="bundle_name"/>
            </group>
          </group>
          <group string="有效期限">
            <field name="valid_from"/>
            <field name="valid_to"/>
          </group>
          <group>
            <field name="note" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_accessory_search" model="ir.ui.view">
    <field name="name">dms.accessory.search</field>
    <field name="model">dms.accessory</field>
    <field name="arch" type="xml">
      <search string="搜尋精品售價">
        <field name="name" string="精品名稱"/>
        <field name="model_number" string="型號"/>
        <separator/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
      </search>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_accessory" model="ir.actions.act_window">
    <field name="name">精品售價</field>
    <field name="res_model">dms.accessory</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

</odoo>
