<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <data noupdate="1">

    <!-- ╔═══════════════════════════════════════════╗ -->
    <!-- ║  報表規則 — 安全性群組                     ║ -->
    <!-- ╚═══════════════════════════════════════════╝ -->

    <record id="group_dms_report_rule_user" model="res.groups">
      <field name="name">報表規則使用者</field>
      <field name="category_id" ref="base.module_category_hidden"/>
      <field name="comment">可建立並管理自己的報表規則，瀏覽公開規則及使用預覽功能。</field>
    </record>

    <record id="group_dms_report_rule_admin" model="res.groups">
      <field name="name">報表規則管理員</field>
      <field name="category_id" ref="base.module_category_hidden"/>
      <field name="users" eval="[(4, ref('base.user_admin'))]"/>
      <field name="implied_ids" eval="[(4, ref('group_dms_report_rule_user'))]"/>
      <field name="comment">可新增、編輯、刪除所有使用者的報表規則。</field>
    </record>

  </data>

</odoo>
