<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_price_line_tree" model="ir.ui.view">
    <field name="name">dms.price.line.tree</field>
    <field name="model">dms.price.line</field>
    <field name="arch" type="xml">
      <tree string="價格基準">
        <field name="version_id" optional="show"/>
        <field name="product_id" optional="show"/>
        <field name="cash_price" optional="show"/>
        <field name="list_price" optional="show"/>
        <field name="note" optional="hide"/>
      </tree>
    </field>
  </record>

  <record id="view_price_line_form" model="ir.ui.view">
    <field name="name">dms.price.line.form</field>
    <field name="model">dms.price.line</field>
    <field name="arch" type="xml">
      <form string="價格基準">
        <sheet>
          <group>
            <group>
              <field name="version_id"/>
              <field name="product_id"/>
            </group>
            <group>
              <field name="cash_price"/>
              <field name="list_price"/>
            </group>
          </group>
          <group>
            <field name="note" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_price_line_search" model="ir.ui.view">
    <field name="name">dms.price.line.search</field>
    <field name="model">dms.price.line</field>
    <field name="arch" type="xml">
      <search string="搜尋價格基準">
        <field name="version_id"/>
        <field name="product_id"/>
        <group expand="0" string="分組">
          <filter name="groupby_version" string="價目版本" context="{'group_by': 'version_id'}"/>
          <filter name="groupby_product" string="產品項 / SKU" context="{'group_by': 'product_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_price_line" model="ir.actions.act_window">
    <field name="name">價格基準</field>
    <field name="res_model">dms.price.line</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

</odoo>
