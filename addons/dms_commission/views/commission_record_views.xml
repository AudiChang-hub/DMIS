<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_commission_record_tree" model="ir.ui.view">
    <field name="name">dms.commission.record.tree</field>
    <field name="model">dms.commission.record</field>
    <field name="arch" type="xml">
      <tree string="傭金記錄" create="false" delete="false">
        <field name="closed_month"/>
        <field name="dealer_id"/>
        <field name="sale_order_id"/>
        <field name="product_tmpl_id"/>
        <field name="closed_date"/>
        <field name="base_commission"/>
        <field name="volume_bonus"/>
        <field name="total_commission"/>
        <field name="state" decoration-danger="state == 'voided'"
               decoration-success="state == 'active'"/>
      </tree>
    </field>
  </record>

  <record id="view_commission_record_form" model="ir.ui.view">
    <field name="name">dms.commission.record.form</field>
    <field name="model">dms.commission.record</field>
    <field name="arch" type="xml">
      <form string="傭金記錄" create="false" delete="false">
        <sheet>
          <group>
            <group>
              <field name="sale_order_id" readonly="1"/>
              <field name="dealer_id" readonly="1"/>
              <field name="product_tmpl_id" readonly="1"/>
              <field name="closed_month" readonly="1"/>
              <field name="closed_date" readonly="1"/>
            </group>
            <group>
              <field name="base_commission" readonly="1"/>
              <field name="volume_bonus" readonly="1"/>
              <field name="total_commission" readonly="1"/>
              <field name="state" readonly="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_commission_record_search" model="ir.ui.view">
    <field name="name">dms.commission.record.search</field>
    <field name="model">dms.commission.record</field>
    <field name="arch" type="xml">
      <search string="搜尋傭金記錄">
        <field name="dealer_id"/>
        <field name="sale_order_id"/>
        <field name="closed_month"/>
        <filter name="state_active" string="正常" domain="[('state','=','active')]"/>
        <filter name="state_voided" string="已撤銷" domain="[('state','=','voided')]"/>
        <group expand="0" string="群組">
          <filter name="group_dealer" string="依車行" context="{'group_by': 'dealer_id'}"/>
          <filter name="group_month" string="依月份" context="{'group_by': 'closed_month'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_commission_record" model="ir.actions.act_window">
    <field name="name">傭金記錄</field>
    <field name="res_model">dms.commission.record</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state','=','active')]</field>
    <field name="context">{'search_default_state_active': True}</field>
  </record>

</odoo>
