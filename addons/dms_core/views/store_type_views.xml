<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_store_type_tree" model="ir.ui.view">
    <field name="name">dms.store_type.tree</field>
    <field name="model">dms.store_type</field>
    <field name="arch" type="xml">
      <tree string="車行類型">
        <field name="name"   optional="show"/>
        <field name="active" optional="show"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖 ===== -->
  <record id="view_store_type_form" model="ir.ui.view">
    <field name="name">dms.store_type.form</field>
    <field name="model">dms.store_type</field>
    <field name="arch" type="xml">
      <form string="車行類型">
        <sheet>
          <group>
            <field name="name"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_store_type_search" model="ir.ui.view">
    <field name="name">dms.store_type.search</field>
    <field name="model">dms.store_type</field>
    <field name="arch" type="xml">
      <search string="搜尋車行類型">
        <field name="name" string="類型名稱"/>
        <separator/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
      </search>
    </field>
  </record>

  <!-- ===== 動作 ===== -->
  <record id="action_store_type" model="ir.actions.act_window">
    <field name="name">車行類型</field>
    <field name="res_model">dms.store_type</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_store_types" name="車行類型" parent="menu_dms_root"
            action="action_store_type" sequence="30"/>

</odoo>
