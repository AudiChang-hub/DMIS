<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_product_template_tree" model="ir.ui.view">
    <field name="name">dms.product.template.tree</field>
    <field name="model">dms.product.template</field>
    <field name="arch" type="xml">
      <tree string="產品頁面">
        <field name="brand_id" optional="show"/>
        <field name="family_name" optional="show"/>
        <field name="type_name" optional="show"/>
        <field name="model_name" optional="show"/>
        <field name="energy_type" optional="show"/>
        <field name="sku_count" optional="show"/>
        <field name="note" string="顧客贈品" optional="show"/>
        <field name="active" optional="show"/>
      </tree>
    </field>
  </record>

  <record id="view_product_template_form" model="ir.ui.view">
    <field name="name">dms.product.template.form</field>
    <field name="model">dms.product.template</field>
    <field name="arch" type="xml">
      <form string="產品頁面">
        <header>
          <button string="💾 儲存" special="save" class="btn-success"
                  title="儲存目前所有填寫的資料"/>
        </header>
        <sheet>
          <div class="alert alert-info" role="alert"
               attrs="{'invisible': [('id', '!=', False)]}">
            <strong>新增產品</strong>：請先填寫品牌、機種、型號、能源型式等必填欄位。填寫完成後，點選下方「新增產品項」時系統將自動儲存模板並開啟新增對話框。
          </div>
          <group>
            <group>
              <field name="brand_id"/>
              <field name="family_name"/>
              <field name="type_name"/>
              <field name="model_name"/>
            </group>
            <group>
              <field name="energy_type"/>
              <field name="active"/>
              <field name="note" string="顧客贈品" placeholder="顧客贈品（選填）"/>
            </group>
          </group>
          <separator string="產品項"/>
          <field name="sku_ids"
                 widget="sku_o2m"
                 nolabel="1"
                 context="{'default_template_id': id, 'active_test': False}">
            <tree decoration-muted="not active" no_open="True" editable="bottom">
              <button name="action_duplicate_from_template_tab"
                      type="object"
                      icon="fa-copy"
                      string=""
                      class="btn-secondary"
                      title="複製此產品項（年份將清空，填寫新年份後按「儲存」即完成）"/>
              <field name="internal_code" readonly="1" optional="hide"/>
              <field name="production_year" string="年份"/>
              <field name="color" string="車色" widget="color_tags"/>
              <field name="suggested_price" string="建議售價"/>
              <field name="cash_discount" string="現金直扣" optional="show"/>
              <field name="cash_price" string="現金價"/>
              <field name="installment_12_price" string="12期" widget="float_blank_zero" optional="show"/>
              <field name="installment_18_price" string="18期" widget="float_blank_zero" optional="show"/>
              <field name="installment_24_price" string="24期" widget="float_blank_zero" optional="show"/>
              <field name="installment_36_price" string="36期" widget="float_blank_zero" optional="show"/>
              <field name="installment_48_price" string="48期" widget="float_blank_zero" optional="show"/>
              <field name="installment_60_price" string="60期" widget="float_blank_zero" optional="show"/>
              <field name="active" optional="show"/>
            </tree>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_product_template_search" model="ir.ui.view">
    <field name="name">dms.product.template.search</field>
    <field name="model">dms.product.template</field>
    <field name="arch" type="xml">
      <search string="搜尋產品頁面">
        <field name="brand_id"/>
        <field name="family_name"/>
        <field name="type_name"/>
        <field name="model_name"/>
        <filter name="filter_active" string="啟用中" domain="[('active', '=', True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active', '=', False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_brand" string="品牌" context="{'group_by': 'brand_id'}"/>
          <filter name="groupby_energy" string="能源型式" context="{'group_by': 'energy_type'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_product_sku_pricelist_tree" model="ir.ui.view">
    <field name="name">dms.product.pricelist.tree</field>
    <field name="model">dms.product</field>
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <tree string="價格表" editable="bottom" multi_edit="1" default_order="name asc, production_year asc">
        <field name="brand_id" optional="show"/>
        <field name="name" string="機種" optional="show"/>
        <field name="template_type_name" string="型式" optional="show"/>
        <field name="model" string="型號" optional="show"/>
        <field name="production_year" string="年份"/>
        <field name="energy_type" string="能源型式" optional="show"/>
        <field name="color" string="車色" optional="show"/>
        <field name="suggested_price" string="建議售價" optional="show"/>
        <field name="cash_discount" string="現金直扣" optional="show"/>
        <field name="cash_price" string="現金價"/>
        <field name="installment_12_price" string="12期" widget="float_blank_zero" optional="show"/>
        <field name="installment_18_price" string="18期" widget="float_blank_zero" optional="show"/>
        <field name="installment_24_price" string="24期" widget="float_blank_zero" optional="show"/>
        <field name="installment_36_price" string="36期" widget="float_blank_zero" optional="show"/>
        <field name="installment_48_price" string="48期" widget="float_blank_zero" optional="show"/>
        <field name="installment_60_price" string="60期" widget="float_blank_zero" optional="show"/>
        <field name="gift_note" string="顧客贈品" optional="show"/>
        <field name="fees_note" string="附加費用說明" optional="show"/>
        <field name="active" optional="show"/>
      </tree>
    </field>
  </record>

  <record id="action_product_template" model="ir.actions.act_window">
    <field name="name">價格表</field>
    <field name="res_model">dms.product</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit', 'active_test': False}</field>
  </record>

  <record id="action_product_template_view_tree" model="ir.actions.act_window.view">
    <field name="sequence" eval="1"/>
    <field name="view_mode">tree</field>
    <field name="view_id" ref="view_product_sku_pricelist_tree"/>
    <field name="act_window_id" ref="action_product_template"/>
  </record>

  <record id="action_product_template_view_form" model="ir.actions.act_window.view">
    <field name="sequence" eval="2"/>
    <field name="view_mode">form</field>
    <field name="view_id" ref="dms_sale.view_product_form"/>
    <field name="act_window_id" ref="action_product_template"/>
  </record>

  <record id="action_product_template_duplicate" model="ir.actions.server">
    <field name="name">複製</field>
    <field name="model_id" ref="model_dms_product_template"/>
    <field name="binding_model_id" ref="model_dms_product_template"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">
copies = env['dms.product.template']
for record in records:
    copies |= record.copy()
if len(copies) == 1:
    action = {
        'type': 'ir.actions.act_window',
        'res_model': 'dms.product.template',
        'res_id': copies.id,
        'view_mode': 'form',
        'target': 'current',
    }
    </field>
  </record>

  <record id="action_dms_product_duplicate" model="ir.actions.server">
    <field name="name">複製</field>
    <field name="model_id" ref="dms_sale.model_dms_product"/>
    <field name="binding_model_id" ref="dms_sale.model_dms_product"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">
for record in records:
    record.copy()
    </field>
  </record>

</odoo>
