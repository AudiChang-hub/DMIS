<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_price_version_tree" model="ir.ui.view">
    <field name="name">dms.price.version.tree</field>
    <field name="model">dms.price.version</field>
    <field name="arch" type="xml">
      <tree string="價目版本">
        <field name="name" optional="show"/>
        <field name="effective_date" optional="show"/>
        <field name="state" optional="show"/>
        <field name="note" optional="hide"/>
      </tree>
    </field>
  </record>

  <record id="view_price_version_form" model="ir.ui.view">
    <field name="name">dms.price.version.form</field>
    <field name="model">dms.price.version</field>
    <field name="arch" type="xml">
      <form string="價目版本">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="effective_date"/>
            </group>
            <group>
              <field name="state"/>
            </group>
          </group>
          <notebook>
            <page string="價格基準">
              <button name="action_open_bulk_add_products_wizard"
                      type="object"
                      string="批次加入產品項"
                      class="oe_highlight"/>
              <field name="line_ids" context="{'default_version_id': active_id}">
                <tree editable="bottom">
                  <field name="product_id"/>
                  <field name="cash_price"/>
                  <field name="list_price"/>
                  <field name="note"/>
                </tree>
              </field>
            </page>
            <page string="備註">
              <field name="note" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_price_version_search" model="ir.ui.view">
    <field name="name">dms.price.version.search</field>
    <field name="model">dms.price.version</field>
    <field name="arch" type="xml">
      <search string="搜尋價目版本">
        <field name="name"/>
        <field name="effective_date"/>
        <filter name="filter_draft" string="草稿" domain="[('state', '=', 'draft')]"/>
        <filter name="filter_effective" string="生效" domain="[('state', '=', 'effective')]"/>
        <filter name="filter_archive" string="封存" domain="[('state', '=', 'archive')]"/>
      </search>
    </field>
  </record>

  <record id="action_price_version" model="ir.actions.act_window">
    <field name="name">價目版本</field>
    <field name="res_model">dms.price.version</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

</odoo>
