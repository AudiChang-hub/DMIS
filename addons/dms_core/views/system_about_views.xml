<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_system_about_form" model="ir.ui.view">
    <field name="name">dms.system.about.form</field>
    <field name="model">dms.system.about</field>
    <field name="arch" type="xml">
      <form string="系統版本資訊" create="false" edit="false" delete="false">
        <sheet>
          <notebook>
            <page string="模組版本">
              <field name="version_html" nolabel="1" readonly="1"/>
            </page>
            <page string="版本歷程">
              <field name="changelog_html" nolabel="1" readonly="1"/>
            </page>
          </notebook>
        </sheet>
        <footer>
          <button string="關閉" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_system_about" model="ir.actions.act_window">
    <field name="name">系統版本資訊</field>
    <field name="res_model">dms.system.about</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_system_about_form"/>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_system_about_root"
            name="系統資訊"
            sequence="999"/>

  <menuitem id="menu_system_about"
            name="版本資訊"
            parent="menu_system_about_root"
            action="action_system_about"
            sequence="10"/>

</odoo>
