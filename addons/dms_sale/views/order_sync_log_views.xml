<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 同步紀錄 清單視圖 ===== -->
  <record id="view_order_sync_log_tree" model="ir.ui.view">
    <field name="name">dms.sync.log.tree</field>
    <field name="model">dms.sync.log</field>
    <field name="arch" type="xml">
      <tree string="同步紀錄" decoration-danger="state=='fail'"
            decoration-success="state=='success'"
            decoration-muted="state in ('skip','ignored')">
        <field name="sync_time"/>
        <field name="folder_name"/>
        <field name="state"/>
        <field name="order_id"/>
        <field name="error_msg" optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 同步紀錄 表單視圖 ===== -->
  <record id="view_order_sync_log_form" model="ir.ui.view">
    <field name="name">dms.sync.log.form</field>
    <field name="model">dms.sync.log</field>
    <field name="arch" type="xml">
      <form string="同步紀錄">
        <sheet>
          <group>
            <group>
              <field name="sync_time" readonly="1"/>
              <field name="folder_name" readonly="1"/>
              <field name="state" readonly="1"/>
            </group>
            <group>
              <field name="order_id" readonly="1"/>
            </group>
          </group>
          <group>
            <field name="error_msg" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 同步紀錄 搜尋視圖 ===== -->
  <record id="view_order_sync_log_search" model="ir.ui.view">
    <field name="name">dms.sync.log.search</field>
    <field name="model">dms.sync.log</field>
    <field name="arch" type="xml">
      <search string="搜尋同步紀錄">
        <field name="folder_name" string="資料夾名稱"/>
        <field name="order_id"    string="關聯訂單"/>
        <separator/>
        <filter name="filter_success" string="成功" domain="[('state','=','success')]"/>
        <filter name="filter_fail"    string="失敗" domain="[('state','=','fail')]"/>
        <filter name="filter_skip"    string="略過" domain="[('state','=','skip')]"/>
        <filter name="filter_ignored" string="已標記忽略" domain="[('state','=','ignored')]"/>
        <group expand="0" string="分組">
          <filter name="groupby_state" string="狀態" context="{'group_by': 'state'}"/>
          <filter name="groupby_day"   string="日期" context="{'group_by': 'sync_time:day'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== Action ===== -->
  <record id="action_order_sync_log" model="ir.actions.act_window">
    <field name="name">同步紀錄</field>
    <field name="res_model">dms.sync.log</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
  </record>

  <!-- ===== 標記歷史資料 Server Action ===== -->
  <record id="action_mark_ignored_server" model="ir.actions.server">
    <field name="name">標記現有資料夾為歷史（不匯入）</field>
    <field name="model_id" ref="model_dms_sync_log"/>
    <field name="binding_model_id" ref="model_dms_sync_log"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
env['dms.order.sync'].mark_all_existing_ignored()
    </field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_order_sync_log" name="同步紀錄" parent="dms_sale.menu_dms_sale_root"
            action="action_order_sync_log" sequence="50"/>

</odoo>
