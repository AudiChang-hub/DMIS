<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_commission_dealer_rule_tree" model="ir.ui.view">
    <field name="name">dms.commission.dealer.rule.tree</field>
    <field name="model">dms.commission.dealer.rule</field>
    <field name="arch" type="xml">
      <tree string="車行覆蓋規則">
        <field name="dealer_ids" widget="many2many_tags"/>
        <field name="addon_amount"/>
        <field name="note"/>
      </tree>
    </field>
  </record>

  <record id="view_commission_dealer_rule_form" model="ir.ui.view">
    <field name="name">dms.commission.dealer.rule.form</field>
    <field name="model">dms.commission.dealer.rule</field>
    <field name="arch" type="xml">
      <form string="車行覆蓋規則">
        <sheet>
          <group>
            <field name="addon_amount"/>
          </group>
          <separator string="適用車行"/>
          <field name="dealer_ids" nolabel="1" widget="many2many_tags" class="w-100"/>
          <field name="note" string="備註" placeholder="備註" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_commission_dealer_rule" model="ir.actions.act_window">
    <field name="name">車行覆蓋規則</field>
    <field name="res_model">dms.commission.dealer.rule</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
