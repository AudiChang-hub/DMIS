<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- 使用 Odoo 內建欄位選擇，已移除自建 Wizard -->

  <record id="view_dealer_tree" model="ir.ui.view">
    <field name="name">dms.dealer.tree</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <tree string="車行">
        <field name="code"/>
        <field name="name"/>
        <field name="owner_name"/>
        <field name="store_manager"/>
        <field name="phone_1"/>
        <field name="mobile" optional="show"/>
        <field name="store_type_id" optional="show"/>
        <field name="brand_ids" widget="many2many_tags" optional="show"/>
        <field name="active" optional="hide"/>
      </tree>
    </field>
  </record>

  <record id="view_dealer_form" model="ir.ui.view">
    <field name="name">dms.dealer.form</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <form string="車行">
        <sheet>
          <div class="oe_title">
            <label for="code" string="車行代碼"/>
            <h1><field name="code" placeholder="車行代碼"/></h1>
            <label for="name"/>
            <h2><field name="name" placeholder="車行名稱"/></h2>
          </div>
          <notebook>
            <page string="基本資料">
              <group string="車行資訊">
                <group>
                  <field name="short_name" string="簡稱"/>
                  <field name="store_type_id" string="車行類型"/>
                  <field name="brand_ids" string="品牌" widget="many2many_tags"/>
                  <field name="active" string="啟用"/>
                </group>
                <group>
                  <field name="address" string="地址"/>
                  <field name="city" string="縣市"/>
                  <field name="district" string="鄉鎮市區"/>
                </group>
              </group>
              <group string="人員">
                <group>
                  <field name="owner_name" string="負責人"/>
                  <field name="manager_same_as_owner" string="店長同上（同負責人）"/>
                  <field name="store_manager" string="店長"/>
                </group>
              </group>
              <group string="備註">
                <field name="note" nolabel="1" colspan="2"/>
              </group>
            </page>
            <page string="聯絡資訊">
              <group>
                <field name="phone_1" string="電話1"/>
                <field name="phone_2" string="電話2"/>
                <field name="mobile" string="手機"/>
                <field name="mobile_fax" string="手機/傳真"/>
                <field name="email" string="電子郵件"/>
              </group>
            </page>
            <page string="價格表 / 群組">
              <group>
                <group string="三陽">
                  <field name="sym_price_list" string="三陽價格表"/>
                  <field name="sym_dispatch_capacity" string="三陽排車容量"/>
                </group>
                <group string="台鈴">
                  <field name="suzuki_price_list" string="台鈴價格表"/>
                  <field name="suzuki_dispatch_capacity" string="台鈴排車容量"/>
                </group>
              </group>
              <group>
                <field name="line_group" string="有 LINE 群組"/>
                <field name="holiday_gift" string="年節送禮"/>
              </group>
            </page>
            <page string="進階">
              <group>
                <field name="tags" widget="many2many_tags" string="標籤"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_dealer_search" model="ir.ui.view">
    <field name="name">dms.dealer.search</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <search>
        <field name="code"/>
        <field name="phone_1"/>
        <field name="mobile"/>
        <field name="phone_2"/>
        <field name="short_name"/>
        <filter name="active" string="啟用" domain="[('active','=',True)]"/>
        <filter name="holiday_gift" string="年節送禮" domain="[('holiday_gift','=',True)]"/>
        <filter name="sym_price_gas" string="三陽-油車" domain="[('sym_price_list','=','gas')]"/>
        <filter name="sym_price_ev" string="三陽-電車" domain="[('sym_price_list','=','ev')]"/>
        <filter name="suzuki_price_gas" string="台鈴-油車" domain="[('suzuki_price_list','=','gas')]"/>
        <filter name="suzuki_price_ev" string="台鈴-電車" domain="[('suzuki_price_list','=','ev')]"/>
        <group expand="0" string="分組">
          <filter name="groupby_store_type" string="車行類型" context="{'group_by': 'store_type_id'}"/>
          <filter name="groupby_city" string="縣市" context="{'group_by': 'city'}"/>
        </group>
        </search>
    </field>
  </record>

  <menuitem id="menu_dms_root" name="DMS"/>
  <menuitem id="menu_dealer" name="車行" parent="menu_dms_root"/>

  <record id="action_dealer" model="ir.actions.act_window">
    <field name="name">車行</field>
    <field name="res_model">dms.dealer</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>
  <menuitem id="menu_dealer_action" name="列表" parent="menu_dealer" action="action_dealer"/>
  <record id="action_dealer_create" model="ir.actions.act_window">
    <field name="name">新增車行</field>
    <field name="res_model">dms.dealer</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>
  <menuitem id="menu_dealer_create" name="新增" parent="menu_dealer" action="action_dealer_create"/>
  <!-- 車行類型管理 -->
  <record id="view_dealer_type_tree" model="ir.ui.view">
    <field name="name">dms.dealer.type.tree</field>
    <field name="model">dms.dealer.type</field>
    <field name="arch" type="xml">
      <tree string="車行類型">
        <field name="name"/>
        <field name="code"/>
      </tree>
    </field>
  </record>
  <record id="view_dealer_type_form" model="ir.ui.view">
    <field name="name">dms.dealer.type.form</field>
    <field name="model">dms.dealer.type</field>
    <field name="arch" type="xml">
      <form string="車行類型">
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_dealer_type" model="ir.actions.act_window">
    <field name="name">車行類型</field>
    <field name="res_model">dms.dealer.type</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_dealer_type_tree"/>
  </record>
  <menuitem id="menu_dealer_types" name="車行類型管理" parent="menu_dms_root" action="action_dealer_type"/>

  <!-- 品牌管理 -->
  <record id="view_brand_tree" model="ir.ui.view">
    <field name="name">dms.brand.tree</field>
    <field name="model">dms.brand</field>
    <field name="arch" type="xml">
      <tree string="品牌">
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_brand_form" model="ir.ui.view">
    <field name="name">dms.brand.form</field>
    <field name="model">dms.brand</field>
    <field name="arch" type="xml">
      <form string="品牌">
        <sheet>
          <group>
            <field name="name"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_brand" model="ir.actions.act_window">
    <field name="name">品牌</field>
    <field name="res_model">dms.brand</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_brand_tree"/>
  </record>
  <menuitem id="menu_brands" name="品牌管理" parent="menu_dms_root" action="action_brand"/>
  <!-- Tag 管理介面 -->
  <record id="view_dealer_tag_tree" model="ir.ui.view">
    <field name="name">dms.dealer.tag.tree</field>
    <field name="model">dms.dealer.tag</field>
    <field name="arch" type="xml">
      <tree string="車行標籤">
        <field name="name"/>
      </tree>
    </field>
  </record>
  <record id="view_dealer_tag_form" model="ir.ui.view">
    <field name="name">dms.dealer.tag.form</field>
    <field name="model">dms.dealer.tag</field>
    <field name="arch" type="xml">
      <form string="車行標籤">
        <sheet>
          <group>
            <field name="name"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_dealer_tag" model="ir.actions.act_window">
    <field name="name">車行標籤</field>
    <field name="res_model">dms.dealer.tag</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_dealer_tag_tree"/>
  </record>
  <menuitem id="menu_dealer_tags" name="標籤管理" parent="menu_dms_root" action="action_dealer_tag"/>
  <!-- 已移除自建欄位選擇選單，改用 Odoo 內建欄位選擇 -->
</odoo>
