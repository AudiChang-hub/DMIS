<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 清單視圖 ===== -->
  <record id="view_dealer_tree" model="ir.ui.view">
    <field name="name">dms.dealer.tree</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <tree string="車行">
        <!-- 預設顯示（optional="show"）：9 欄，≤ 15 軟性上限 -->
        <field name="code"          optional="show"/>
        <field name="name"          optional="show"/>
        <field name="owner_name"    optional="show"/>
        <field name="store_manager" optional="show"/>
        <field name="phone_1"       optional="show"/>
        <field name="mobile"        optional="show"/>
        <field name="store_type_id" optional="show"/>
        <field name="brand_ids" widget="many2many_tags" optional="show"/>
        <field name="active"        optional="show"/>
        <!-- 預設隱藏（optional="hide"）：可在欄位選擇器勾選顯示 -->
        <field name="phone_2"                optional="hide"/>
        <field name="mobile_fax"             optional="hide"/>
        <field name="email"                  optional="hide"/>
        <field name="sym_gas_price_list"     optional="hide"/>
        <field name="sym_ev_price_list"      optional="hide"/>
        <field name="suzuki_gas_price_list"  optional="hide"/>
        <field name="suzuki_ev_price_list"   optional="hide"/>
        <field name="sym_dispatch_capacity"  optional="hide"/>
        <field name="suzuki_dispatch_capacity" optional="hide"/>
        <field name="line_group"             optional="hide"/>
        <field name="manager_same_as_owner"   optional="hide"/>
        <field name="holiday_gift"           optional="hide"/>
        <field name="address"                optional="hide"/>
        <field name="note"                   optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 表單視圖（4 分頁）===== -->
  <record id="view_dealer_form" model="ir.ui.view">
    <field name="name">dms.dealer.form</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <form string="車行">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="店名"/></h1>
          </div>
          <group>
            <group>
              <field name="code"/>
              <field name="store_type_id"/>
              <field name="active"/>
            </group>
            <group>
              <field name="brand_ids" widget="many2many_tags"/>
            </group>
          </group>
          <notebook>
            <page string="基本資料">
              <group string="人員">
                <field name="owner_name"/>
                <field name="manager_same_as_owner"/>
                <field name="store_manager"
                       attrs="{'readonly': [('manager_same_as_owner', '=', True)]}"/>
              </group>
              <group string="地點與備註">
                <field name="address" colspan="2"/>
                <field name="note" colspan="2"/>
              </group>
            </page>
            <page string="聯絡資訊">
              <group>
                <field name="phone_1"/>
                <field name="phone_2"/>
                <field name="mobile"/>
                <field name="mobile_fax"/>
                <field name="email"/>
              </group>
            </page>
            <page string="價格表／群組">
              <group string="三陽">
                <field name="sym_gas_price_list"/>
                <field name="sym_ev_price_list"/>
              </group>
              <group string="台鈴">
                <field name="suzuki_gas_price_list"/>
                <field name="suzuki_ev_price_list"/>
              </group>
              <separator string="群組活動"/>
              <group>
                <field name="line_group"/>
                <field name="holiday_gift"/>
              </group>
            </page>
            <page string="排車容量">
              <group>
                <field name="sym_dispatch_capacity"/>
                <field name="suzuki_dispatch_capacity"/>
              </group>
              <div class="alert alert-warning" role="alert">
                <span>排車容量不得為負數，儲存時將自動驗證。</span>
              </div>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 搜尋視圖 ===== -->
  <record id="view_dealer_search" model="ir.ui.view">
    <field name="name">dms.dealer.search</field>
    <field name="model">dms.dealer</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="店名"/>
        <field name="owner_name"/>
        <field name="store_manager"/>
        <field name="phone_1"/>
        <field name="mobile"/>
        <field name="address"/>
        <field name="brand_ids" string="品牌"/>
        <separator/>
        <filter name="filter_active" string="啟用中" domain="[('active','=',True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active','=',False)]"/>
        <filter name="filter_holiday_gift" string="年節送禮" domain="[('holiday_gift','=',True)]"/>
        <filter name="filter_line_group" string="LINE群組" domain="[('line_group','=',True)]"/>
        <separator/>
        <filter name="filter_sym_gas" string="三陽油車價格表" domain="[('sym_gas_price_list','=',True)]"/>
        <filter name="filter_sym_ev" string="三陽電車價格表" domain="[('sym_ev_price_list','=',True)]"/>
        <filter name="filter_suzuki_gas" string="台鈴油車價格表" domain="[('suzuki_gas_price_list','=',True)]"/>
        <filter name="filter_suzuki_ev" string="台鈴電車價格表" domain="[('suzuki_ev_price_list','=',True)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_store_type" string="車行類型" context="{'group_by': 'store_type_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== 動作 (record 形式) ===== -->
  <record id="action_dealer" model="ir.actions.act_window">
    <field name="name">車行</field>
    <field name="res_model">dms.dealer</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_dms_root" name="車行管理"/>
  <menuitem id="menu_dealer" name="車行" parent="menu_dms_root"
            action="action_dealer" sequence="10"/>

  <!-- ===== Server Action：車行複製 ===== -->
  <record id="action_dealer_duplicate" model="ir.actions.server">
    <field name="name">複製</field>
    <field name="model_id" ref="model_dms_dealer"/>
    <field name="binding_model_id" ref="model_dms_dealer"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
for record in records:
    record.copy()
    </field>
  </record>

</odoo>
