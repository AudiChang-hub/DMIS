<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_commission_volume_rule_tree" model="ir.ui.view">
    <field name="name">dms.commission.volume.rule.tree</field>
    <field name="model">dms.commission.volume.rule</field>
    <field name="arch" type="xml">
      <tree string="台數現金獎勵規則">
        <field name="rule_type" widget="badge"
               decoration-info="rule_type == 'general'"
               decoration-warning="rule_type == 'specific'"/>
        <field name="name"/>
        <field name="mode" optional="show"/>
        <field name="brand_id" optional="show"/>
        <field name="min_qty"/>
        <field name="bonus_per_unit"/>
        <field name="energy_type" optional="show"/>
        <field name="period_type" optional="show"/>
        <field name="date_from" optional="show"/>
        <field name="date_to" optional="show"/>
        <field name="active" optional="show"/>
        <field name="dealer_ids" widget="many2many_tags" optional="hide"/>
        <field name="product_tmpl_ids" widget="many2many_tags" optional="hide"/>
        <field name="note" optional="hide"/>
      </tree>
    </field>
  </record>

  <record id="view_commission_volume_rule_form" model="ir.ui.view">
    <field name="name">dms.commission.volume.rule.form</field>
    <field name="model">dms.commission.volume.rule</field>
    <field name="arch" type="xml">
      <form string="台數現金獎勵規則">
        <sheet>
          <div class="alert alert-warning" role="alert" style="margin-bottom:16px;">
            <strong>❗ 視先後視則：</strong>
            若某車行有任何「特殊規則」（台數現金獎勵或台數實物獎勵），通用規則對該車行將<strong>完全無效</strong>。
            請確認已為特殊車行設定完整的個別規則。
          </div>
          <group>
            <group>
              <field name="name"/>
              <field name="rule_type" readonly="1"/>
              <field name="mode"/>
              <field name="brand_id" placeholder="留空 = 所有品牌"/>
              <field name="min_qty"/>
              <field name="bonus_per_unit"/>
              <field name="energy_type"/>
            </group>
            <group>
              <field name="period_type"/>
              <field name="date_from"
                     attrs="{'required': [('period_type','=','custom')]}"/>
              <field name="date_to"
                     attrs="{'required': [('period_type','=','custom')]}"/>
              <field name="active"/>
            </group>
          </group>
          <separator string="適用車行（留空 = 全部）"/>
          <field name="dealer_ids" nolabel="1" widget="many2many_tags" class="w-100"/>
          <separator string="限定車種（留空 = 不限）"/>
          <field name="product_tmpl_ids" nolabel="1" widget="many2many_tags" class="w-100"/>
          <separator string="備註"/>
          <field name="note" nolabel="1" placeholder="請輸入備註內容..."/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_commission_volume_rule" model="ir.actions.act_window">
    <field name="name">台數現金獎勵規則</field>
    <field name="res_model">dms.commission.volume.rule</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_active': True}</field>
  </record>

</odoo>
