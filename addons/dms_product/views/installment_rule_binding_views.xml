<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_installment_rule_binding_tree" model="ir.ui.view">
    <field name="name">dms.installment.rule.binding.tree</field>
    <field name="model">dms.installment.rule.binding</field>
    <field name="arch" type="xml">
      <tree string="規則掛接">
        <field name="product_id" optional="show"/>
        <field name="price_version_id" optional="show"/>
        <field name="rule_id" optional="show"/>
        <field name="active" optional="show"/>
        <field name="note" optional="hide"/>
      </tree>
    </field>
  </record>

  <record id="view_installment_rule_binding_form" model="ir.ui.view">
    <field name="name">dms.installment.rule.binding.form</field>
    <field name="model">dms.installment.rule.binding</field>
    <field name="arch" type="xml">
      <form string="規則掛接">
        <sheet>
          <group>
            <group>
              <field name="product_id"/>
              <field name="price_version_id"/>
              <field name="rule_id"/>
              <field name="active"/>
            </group>
            <group>
              <field name="note"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_installment_rule_binding_search" model="ir.ui.view">
    <field name="name">dms.installment.rule.binding.search</field>
    <field name="model">dms.installment.rule.binding</field>
    <field name="arch" type="xml">
      <search string="搜尋規則掛接">
        <field name="product_id"/>
        <field name="price_version_id"/>
        <field name="rule_id"/>
        <filter name="filter_active" string="啟用中" domain="[('active', '=', True)]"/>
        <filter name="filter_archived" string="已停用" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="action_installment_rule_binding" model="ir.actions.act_window">
    <field name="name">規則掛接</field>
    <field name="res_model">dms.installment.rule.binding</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

</odoo>
