<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- QWeb 靜態頁面模板：以 web.layout 包裹，沿用 Odoo 後台樣式 -->
  <template id="system_about_page" name="DMIS 系統版本資訊">
    <t t-call="web.layout">
      <t t-set="head_assets">
        <t t-call-assets="web.assets_common" t-css="true" t-js="false"/>
        <t t-call-assets="web.assets_backend" t-css="true" t-js="false"/>
      </t>
      <t t-set="head">
        <title>系統版本資訊 | DMIS</title>
      </t>
      <body class="o_web_client">
        <div class="container py-4" style="max-width:960px;">
          <h1 style="margin-bottom:1rem;">系統版本資訊</h1>
          <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
              <a class="nav-link active" data-bs-toggle="tab" href="#tab-version" role="tab">模組版本</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" data-bs-toggle="tab" href="#tab-changelog" role="tab">版本歷程</a>
            </li>
          </ul>
          <div class="tab-content pt-3">
            <div id="tab-version" class="tab-pane active" role="tabpanel">
              <t t-raw="version_html"/>
            </div>
            <div id="tab-changelog" class="tab-pane" role="tabpanel">
              <t t-raw="changelog_html"/>
            </div>
          </div>
          <div class="mt-4">
            <a href="/web" class="btn btn-secondary">返回 DMIS 主畫面</a>
          </div>
        </div>
      </body>
    </t>
  </template>

  <!-- 動作：直接導向 /dms/system/about URL，避免 form view 顯示 "New" 標題 -->
  <record id="action_system_about" model="ir.actions.act_url">
    <field name="name">系統版本資訊</field>
    <field name="url">/dms/system/about</field>
    <field name="target">self</field>
  </record>

  <menuitem id="menu_system_about_root"
            name="系統資訊"
            sequence="999"/>

  <menuitem id="menu_system_about"
            name="版本資訊"
            parent="menu_system_about_root"
            action="action_system_about"
            sequence="10"/>

</odoo>
