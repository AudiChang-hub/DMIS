<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_commission_dealer_rule_tree" model="ir.ui.view">
    <field name="name">dms.commission.dealer.rule.tree</field>
    <field name="model">dms.commission.dealer.rule</field>
    <field name="arch" type="xml">
      <tree string="車行覆蓋規則"
            decoration-success="addon_amount > 0"
            decoration-danger="addon_amount &lt; 0">
        <field name="dealer_ids" widget="many2many_tags"/>
        <field name="brand_id" optional="show"/>
        <field name="energy_type" optional="show"/>
        <field name="addon_amount"/>
        <field name="incentive_summary" optional="show"/>
        <field name="note" optional="show"/>
      </tree>
    </field>
  </record>

  <record id="view_commission_dealer_rule_form" model="ir.ui.view">
    <field name="name">dms.commission.dealer.rule.form</field>
    <field name="model">dms.commission.dealer.rule</field>
    <field name="arch" type="xml">
      <form string="車行覆蓋規則">
        <sheet>
          <group>
            <group>
              <field name="addon_amount"/>
              <field name="brand_id" placeholder="留空 = 所有品牌"/>
              <field name="energy_type"/>
            </group>
          </group>
          <separator string="適用車行"/>
          <field name="dealer_ids" nolabel="1" widget="many2many_tags" class="w-100"/>
          <separator string="折換零件明細（每台結案後附帶給出，留空代表純現金加碼）"/>
          <field name="incentive_line_ids" nolabel="1">
            <tree editable="bottom">
              <field name="sequence" widget="handle"/>
              <field name="part_id"/>
              <field name="quantity"/>
            </tree>
          </field>
          <separator string="備註"/>
          <field name="note" nolabel="1" placeholder="請輸入備註內容..."/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_commission_dealer_rule" model="ir.actions.act_window">
    <field name="name">車行覆蓋規則</field>
    <field name="res_model">dms.commission.dealer.rule</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
