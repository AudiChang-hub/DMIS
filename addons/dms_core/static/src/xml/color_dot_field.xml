<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!--
    dms_core.ColorDotField  OWL 模板
    - readonly（列表）：顯示單一彩色圓點 + tooltip
    - editable（表單）：圓點預覽 + 下拉式選單
  -->
  <t t-name="dms_core.ColorDotField" owl="1">

    <!-- ── 唯讀模式（列表視圖）── -->
    <t t-if="props.readonly">
      <span
        class="dms-color-dot"
        t-att-data-color="props.value or 'gray'"
        t-att-title="colorLabel"
      />
    </t>

    <!-- ── 可編輯模式（表單視圖）── -->
    <t t-else="">
      <div class="dms-color-dot-select-wrapper">
        <!-- 目前選色的圓點預覽 -->
        <span
          class="dms-color-dot dms-color-dot-preview"
          t-att-data-color="props.value or 'gray'"
        />
        <!-- 下拉式選單 -->
        <select
          class="dms-color-dot-select o_input"
          t-on-change="(ev) => this.onChange(ev)"
        >
          <t t-foreach="options" t-as="opt" t-key="opt.value">
            <option
              t-att-value="opt.value"
              t-att-selected="props.value === opt.value ? true : undefined"
              t-esc="opt.label"
            />
          </t>
        </select>
      </div>
    </t>

  </t>
</templates>
