<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 產品 Kanban 卡片欄位設定 — 表單視圖 ===== -->
  <record id="view_dms_kanban_product_config_form" model="ir.ui.view">
    <field name="name">dms.kanban.product.config.form</field>
    <field name="model">dms.kanban.product.config</field>
    <field name="arch" type="xml">
      <form string="產品卡片顯示設定">
        <sheet>
          <div class="alert alert-info o_form_no_cog mb16" role="alert">
            已選 <strong><field name="selected_count" style="display:inline;"/></strong> 個欄位（最多 10 個）
          </div>
          <group string="可顯示欄位">
            <field name="show_model"       widget="boolean_toggle"/>
            <field name="show_year"        widget="boolean_toggle"/>
            <field name="show_brake_type"  widget="boolean_toggle"/>
            <field name="show_energy_type" widget="boolean_toggle"/>
            <field name="show_color"       widget="boolean_toggle"/>
            <field name="show_color_code"  widget="boolean_toggle"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== Action（單一設定記錄，res_id 留空由 action 自動建立）===== -->
  <record id="action_dms_kanban_product_config" model="ir.actions.act_window">
    <field name="name">產品卡片顯示設定</field>
    <field name="res_model">dms.kanban.product.config</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 子選單：卡片欄位設定 ===== -->
  <menuitem id="menu_product_kanban_config"
            name="卡片欄位設定"
            parent="menu_dms_product_root"
            action="action_dms_kanban_product_config"
            sequence="20"/>

</odoo>
