<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 產品 Kanban 卡片欄位設定 — 表單視圖 ===== -->
  <record id="view_kanban_product_config_form" model="ir.ui.view">
    <field name="name">dms.kanban.product.config.form</field>
    <field name="model">dms.kanban.product.config</field>
    <field name="arch" type="xml">
      <form string="產品卡片顯示設定">
        <sheet>
          <div class="alert alert-info o_form_no_cog mb16" role="alert">
            已選 <strong><field name="selected_count" style="display:inline;"/></strong> 個欄位（最多 10 個）
          </div>
          <group string="基本資料">
            <field name="show_model"       widget="boolean_toggle"/>
            <field name="show_year"        widget="boolean_toggle"/>
            <field name="show_brake_type"  widget="boolean_toggle"/>
            <field name="show_energy_type" widget="boolean_toggle"/>
            <field name="show_color"       widget="boolean_toggle"/>
            <field name="show_color_code"  widget="boolean_toggle"/>
          </group>
          <group string="動力規格（油車）">
            <field name="show_engine_displacement" widget="boolean_toggle"/>
            <field name="show_fuel_tank"           widget="boolean_toggle"/>
            <field name="show_engine_type"         widget="boolean_toggle"/>
            <field name="show_consumption_grade"   widget="boolean_toggle"/>
            <field name="show_efficiency"          widget="boolean_toggle"/>
            <field name="show_max_hp"              widget="boolean_toggle"/>
            <field name="show_max_torque"          widget="boolean_toggle"/>
          </group>
          <group string="動力規格（電車）">
            <field name="show_power_system"      widget="boolean_toggle"/>
            <field name="show_max_output"        widget="boolean_toggle"/>
            <field name="show_ev_max_hp"         widget="boolean_toggle"/>
            <field name="show_ev_max_torque"     widget="boolean_toggle"/>
            <field name="show_ev_efficiency"     widget="boolean_toggle"/>
            <field name="show_transmission"      widget="boolean_toggle"/>
            <field name="show_battery_capacity"  widget="boolean_toggle"/>
            <field name="show_battery_type"      widget="boolean_toggle"/>
            <field name="show_charge_time"       widget="boolean_toggle"/>
          </group>
          <group string="車身規格">
            <field name="show_dimensions"     widget="boolean_toggle"/>
            <field name="show_seat_height"    widget="boolean_toggle"/>
            <field name="show_wheel_base"     widget="boolean_toggle"/>
            <field name="show_vehicle_weight" widget="boolean_toggle"/>
            <field name="show_tire_front"     widget="boolean_toggle"/>
            <field name="show_tire_rear"      widget="boolean_toggle"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== Server Action：開啟 singleton 設定 ===== -->
  <record id="action_open_kanban_product_config" model="ir.actions.server">
    <field name="name">產品卡片設定</field>
    <field name="model_id" ref="model_dms_kanban_product_config"/>
    <field name="state">code</field>
    <field name="code">
config = env['dms.kanban.product.config'].get_kanban_config()
action = {
    'type': 'ir.actions.act_window',
    'name': '產品卡片顯示設定',
    'res_model': 'dms.kanban.product.config',
    'view_mode': 'form',
    'res_id': config.id,
    'target': 'new',
}
    </field>
  </record>

</odoo>
