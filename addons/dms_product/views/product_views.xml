<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== Tree View ===== -->
  <record id="view_product_tree" model="ir.ui.view">
    <field name="name">dms.product.tree</field>
    <field name="model">dms.product</field>
    <field name="arch" type="xml">
      <tree string="產品清單">
        <!-- 預設顯示（optional="show"）-->
        <field name="brand_id"    optional="show"/>
        <field name="name"        optional="show"/>
        <field name="model"       optional="show"/>
        <field name="year"        optional="show"/>
        <field name="brake_type"  optional="show"/>
        <field name="energy_type" optional="show"/>
        <field name="color"       optional="show"/>
        <field name="color_code"  optional="hide"/>
        <field name="active"      optional="show"/>
        <!-- 動力規格（油車）— 預設隱藏 -->
        <field name="engine_displacement" optional="hide"/>
        <field name="fuel_tank"           optional="hide"/>
        <field name="engine_type"         optional="hide"/>
        <field name="consumption_grade"   optional="hide"/>
        <field name="efficiency"          optional="hide"/>
        <field name="max_hp"              optional="hide"/>
        <field name="max_torque"          optional="hide"/>
        <!-- 動力規格（電車）— 預設隱藏 -->
        <field name="power_system"     optional="hide"/>
        <field name="max_output"       optional="hide"/>
        <field name="ev_max_hp"        optional="hide"/>
        <field name="ev_max_torque"    optional="hide"/>
        <field name="ev_efficiency"    optional="hide"/>
        <field name="transmission"     optional="hide"/>
        <field name="battery_capacity" optional="hide"/>
        <field name="battery_type"     optional="hide"/>
        <field name="charge_time"      optional="hide"/>
        <!-- 車身規格 — 預設隱藏 -->
        <field name="dimensions"      optional="hide"/>
        <field name="seat_height"     optional="hide"/>
        <field name="wheel_base"      optional="hide"/>
        <field name="vehicle_weight"  optional="hide"/>
        <field name="tire_front"      optional="hide"/>
        <field name="tire_rear"       optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== Form View ===== -->
  <record id="view_product_form" model="ir.ui.view">
    <field name="name">dms.product.form</field>
    <field name="model">dms.product</field>
    <field name="arch" type="xml">
      <form string="產品">
        <sheet>
          <div class="oe_button_box" name="button_box"/>
          <!-- 圖片區塊（右上角）-->
          <field name="image_1920" widget="image"
                 class="oe_avatar"
                 options="{'zoom': true, 'preview_image': 'image_128'}"/>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="產品名稱"/></h1>
          </div>
          <notebook>
            <!-- 頁籤1：基本資料 -->
            <page string="基本資料">
              <group>
                <field name="brand_id"/>
                <field name="name"/>
                <field name="model"/>
                <field name="year"/>
                <field name="brake_type"/>
                <field name="energy_type"/>
                <field name="color"/>
                <field name="color_code"/>
                <field name="active"/>
              </group>
            </page>

            <!-- 頁籤2：動力規格（油車）— 僅 energy_type == 'oil' 時顯示 -->
            <page string="動力規格(油車)"
                  attrs="{'invisible': [('energy_type', '!=', 'oil')]}">
              <group>
                <field name="engine_displacement"/>
                <field name="fuel_tank"/>
                <field name="engine_type"/>
                <field name="consumption_grade"/>
                <field name="efficiency"/>
                <field name="max_hp"/>
                <field name="max_torque"/>
              </group>
            </page>

            <!-- 頁籁4：動力規格（電車）— 僅 energy_type == 'electric' 時顯示 -->
            <page string="動力規格(電車)"
                  attrs="{'invisible': [('energy_type', '!=', 'electric')]}">
              <group>
                <field name="power_system"/>
                <field name="max_output"/>
                <field name="ev_max_hp"/>
                <field name="ev_max_torque"/>
                <field name="ev_efficiency"/>
                <field name="transmission"/>
                <field name="battery_capacity"/>
                <field name="battery_type"/>
                <field name="charge_time"/>
              </group>
            </page>

            <!-- 頁籤4：車身規格（永遠顯示） -->
            <page string="車身規格">
              <group>
                <field name="dimensions"/>
                <field name="seat_height"/>
                <field name="wheel_base"/>
                <field name="vehicle_weight"/>
                <field name="tire_front"/>
                <field name="tire_rear"/>
              </group>
            </page>

          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== Kanban View ===== -->
  <record id="view_product_kanban" model="ir.ui.view">
    <field name="name">dms.product.kanban</field>
    <field name="model">dms.product</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile" sample="1">
        <field name="id"/>
        <field name="name"/>
        <field name="brand_id"/>
        <field name="model"/>
        <field name="year"/>
        <field name="energy_type"/>
        <field name="color"/>
        <field name="color_code"/>
        <field name="active"/>
        <field name="kanban_cfg_model"/>
        <field name="kanban_cfg_year"/>
        <field name="kanban_cfg_brake_type"/>
        <field name="kanban_cfg_energy_type"/>
        <field name="kanban_cfg_color"/>
        <field name="kanban_cfg_color_code"/>
        <field name="brake_type"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_card oe_kanban_global_click dms-product-kanban-card">
              <div class="dms-product-kanban-body">
                <!-- 常驅：品牌 + 產品名 -->
                <div class="dms-product-kanban-header">
                  <span class="dms-product-kanban-brand text-muted">
                    <t t-esc="record.brand_id.value"/>
                  </span>
                  <strong class="dms-product-kanban-name">
                    <t t-esc="record.name.value"/>
                  </strong>
                </div>
                <!-- 可設定欄位 -->
                <div class="dms-product-kanban-fields">
                  <t t-if="record.kanban_cfg_model.raw_value and record.model.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">型號</span>
                      <span class="dms-field-val"><t t-esc="record.model.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_year.raw_value and record.year.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">年份</span>
                      <span class="dms-field-val"><t t-esc="record.year.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_brake_type.raw_value and record.brake_type.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">煮車型式</span>
                      <span class="dms-field-val"><t t-esc="record.brake_type.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_energy_type.raw_value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">能源</span>
                      <span t-att-class="'badge ' + (record.energy_type.raw_value === 'oil' ? 'badge-warning' : 'badge-success')">
                        <t t-esc="record.energy_type.value"/>
                      </span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_color.raw_value and record.color.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">顏色</span>
                      <span class="dms-field-val"><t t-esc="record.color.value"/></span>
                    </span>
                  </t>
                  <t t-if="record.kanban_cfg_color_code.raw_value and record.color_code.value">
                    <span class="dms-field-row">
                      <span class="dms-field-label">色碼</span>
                      <span class="dms-field-val"><t t-esc="record.color_code.value"/></span>
                    </span>
                  </t>
                </div>
                <!-- 停用 badge -->
                <t t-if="!record.active.raw_value">
                  <span class="badge badge-danger mt4">停用</span>
                </t>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- ===== Search View ===== -->
  <record id="view_product_search" model="ir.ui.view">
    <field name="name">dms.product.search</field>
    <field name="model">dms.product</field>
    <field name="arch" type="xml">
      <search string="搜尋產品">
        <field name="name" string="名稱"/>
        <field name="model" string="型號"/>
        <field name="brand_id" string="品牌"/>
        <separator/>
        <filter name="filter_oil" string="油車" domain="[('energy_type', '=', 'oil')]"/>
        <filter name="filter_electric" string="電車" domain="[('energy_type', '=', 'electric')]"/>
        <filter name="filter_active" string="啟用中" domain="[('active', '=', True)]"/>
        <filter name="filter_archived" string="已歸檔" domain="[('active', '=', False)]"/>
        <group expand="0" string="分組">
          <filter name="groupby_brand" string="品牌" context="{'group_by': 'brand_id'}"/>
          <filter name="groupby_energy" string="能源型式" context="{'group_by': 'energy_type'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== Action ===== -->
  <record id="action_product" model="ir.actions.act_window">
    <field name="name">產品管理</field>
    <field name="res_model">dms.product</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="context">{'form_view_initial_mode': 'edit'}</field>
  </record>

  <!-- ===== 選單 ===== -->
  <!-- 頂層：與 DMS Core 並列，出現在 Odoo 首頁 App 列 -->
  <menuitem id="menu_dms_product_root" name="產品管理" sequence="30"/>
  <menuitem id="menu_product" name="產品管理" parent="menu_dms_product_root"
            action="action_product" sequence="10"/>

</odoo>
