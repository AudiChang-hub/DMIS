<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ===== 同步紀錄 清單視圖 ===== -->
  <record id="view_order_sync_log_tree" model="ir.ui.view">
    <field name="name">dms.sync.log.tree</field>
    <field name="model">dms.sync.log</field>
    <field name="arch" type="xml">
      <tree string="OrderProcessor 暫存區" decoration-danger="state=='fail'"
            decoration-success="state=='success'"
            decoration-muted="state in ('skip','ignored')">
        <field name="sync_time"/>
        <field name="folder_name"/>
        <field name="state"/>
        <field name="customer_name" optional="show"/>
        <field name="source_product_name" optional="show"/>
        <field name="dealer_id" optional="show"/>
        <field name="fallback_used" optional="show"/>
        <field name="order_id" optional="hide" string="歷史關聯訂單"/>
        <field name="error_msg" optional="hide"/>
      </tree>
    </field>
  </record>

  <!-- ===== 同步紀錄 表單視圖 ===== -->
  <record id="view_order_sync_log_form" model="ir.ui.view">
    <field name="name">dms.sync.log.form</field>
    <field name="model">dms.sync.log</field>
    <field name="arch" type="xml">
      <form string="OrderProcessor 暫存紀錄">
        <header>
          <button name="action_resync" type="object"
                  string="重新同步" class="btn-primary"
                  confirm="此操作將刪除目前暫存紀錄並重新從備份資料夾解析。確定繼續？"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="sync_time" readonly="1"/>
              <field name="folder_name" readonly="1"/>
              <field name="state" readonly="1"/>
              <field name="fallback_used" readonly="1"/>
            </group>
            <group>
              <field name="customer_name" readonly="1"/>
              <field name="id_number" readonly="1"/>
              <field name="customer_phone" readonly="1"/>
              <field name="customer_email" readonly="1"/>
              <field name="order_id" readonly="1" string="歷史關聯訂單" attrs="{'invisible': [('order_id', '=', False)]}"/>
            </group>
          </group>
          <group>
            <field name="birthday_ad" readonly="1"/>
            <field name="address_registered" readonly="1"/>
          </group>
          <group string="解析結果">
            <group>
              <field name="source_product_name" readonly="1"/>
              <field name="product_id" readonly="1"/>
              <field name="source_color_name" readonly="1"/>
              <field name="color_id" readonly="1"/>
              <field name="extra_other" readonly="1"/>
            </group>
            <group>
              <field name="source_dealer_name" readonly="1"/>
              <field name="dealer_id" readonly="1"/>
              <field name="sale_type" readonly="1"/>
              <field name="payment_method" readonly="1"/>
              <field name="finance_company" readonly="1"/>
              <field name="finance_company_other" readonly="1"/>
              <field name="installment_periods" readonly="1"/>
              <field name="is_trade_in" readonly="1"/>
            </group>
          </group>
          <group>
            <field name="extra_note" readonly="1"/>
            <field name="error_msg" readonly="1"/>
          </group>
          <notebook>
            <page string="標準化快照">
              <field name="staged_vals_json" nolabel="1" readonly="1"/>
            </page>
            <page string="result.json">
              <field name="raw_result_json" nolabel="1" readonly="1"/>
            </page>
            <page string="xlsx fallback">
              <field name="fallback_payload_json" nolabel="1" readonly="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ===== 同步紀錄 搜尋視圖 ===== -->
  <record id="view_order_sync_log_search" model="ir.ui.view">
    <field name="name">dms.sync.log.search</field>
    <field name="model">dms.sync.log</field>
    <field name="arch" type="xml">
      <search string="搜尋 OrderProcessor 暫存區">
        <field name="folder_name" string="資料夾名稱"/>
        <field name="customer_name" string="客戶姓名"/>
        <field name="source_product_name" string="原始車款"/>
        <field name="dealer_id" string="車行"/>
        <field name="order_id" string="歷史關聯訂單"/>
        <separator/>
        <filter name="filter_success" string="成功" domain="[('state','=','success')]"/>
        <filter name="filter_fail"    string="失敗" domain="[('state','=','fail')]"/>
        <filter name="filter_skip"    string="略過" domain="[('state','=','skip')]"/>
        <filter name="filter_ignored" string="已標記忽略" domain="[('state','=','ignored')]"/>
        <group expand="0" string="分組">
          <filter name="groupby_state" string="狀態" context="{'group_by': 'state'}"/>
          <filter name="groupby_day"   string="日期" context="{'group_by': 'sync_time:day'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ===== Action ===== -->
  <record id="action_order_sync_log" model="ir.actions.act_window">
    <field name="name">OrderProcessor 暫存區</field>
    <field name="res_model">dms.sync.log</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
  </record>

  <!-- ===== 標記歷史資料 Server Action ===== -->
  <record id="action_mark_ignored_server" model="ir.actions.server">
    <field name="name">標記現有資料夾為歷史（不匯入）</field>
    <field name="model_id" ref="model_dms_sync_log"/>
    <field name="binding_model_id" ref="model_dms_sync_log"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
env['dms.order.sync'].mark_all_existing_ignored()
    </field>
  </record>

  <!-- ===== 重新同步 Server Action（list 多選） ===== -->
  <record id="action_resync_server" model="ir.actions.server">
    <field name="name">重新同步（重新解析備份資料夾）</field>
    <field name="model_id" ref="model_dms_sync_log"/>
    <field name="binding_model_id" ref="model_dms_sync_log"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
if records:
    action = records.action_resync()
    </field>
  </record>

  <!-- ===== 選單 ===== -->
  <menuitem id="menu_order_sync_log" name="OrderProcessor 暫存區" parent="dms_product.menu_dms_product_root"
            action="action_order_sync_log" sequence="50"/>

</odoo>
