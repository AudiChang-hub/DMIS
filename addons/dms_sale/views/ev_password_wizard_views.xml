<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_dms_ev_password_wizard_form" model="ir.ui.view">
    <field name="name">dms.ev.password.wizard.form</field>
    <field name="model">dms.ev.password.wizard</field>
    <field name="arch" type="xml">
      <form string="解鎖電車帳密">
        <div class="alert alert-warning" role="alert">
          <strong>請輸入解鎖密碼</strong>以顯示電車車控與電池合約帳號密碼。
        </div>
        <group>
          <field name="order_id" invisible="1"/>
          <field name="unlock_password" password="True"
                 placeholder="請輸入解鎖密碼"/>
        </group>
        <footer>
          <button string="驗證並顯示" type="object"
                  name="action_verify" class="btn-primary"/>
          <button string="取消" class="btn-secondary"
                  special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

</odoo>
